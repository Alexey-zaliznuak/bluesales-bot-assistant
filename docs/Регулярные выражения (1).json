// Демонстрация использования регулярных выражений (данная функциональность
// рассчитана только на продвинутых пользователей).

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // В данном примере у нас используется следующее регулярное выражение:
          // /\bпанд[ау]\b/g
          // Данное выражение сработает, если в тексте сообщения
          // имеется слово целиком "панда" или "панду".
          // Слово "пандус" уже не сработает.

          // Но есть небольшие особенности:
          // 1) Указывать нужно выражение, находящееся между "/" и "/g".
          // 2) В JSON "\b" соответствует специальному символу "backspace" (см. json.org),
          // поэтому вместо "\" нужно указывать "\\" (т. к. "\\" соответствует символу "\",
          // по спецификации json.org).
          // Поэтому "\bпанд[ау]\b" в JSON соответствует строке "\\bпанд[ау]\\b".
          // 3) В BlueSales используются движок регулярных выражений .NET.
          // Для тестирования регулярных выражений .NET полезно использовать сайт:
          // http://regexstorm.net/tester

          // Можно указать массив регулярных выражений.
          // Если сообщение клиента соответствует хотя бы одному из них,
          // условие считается выполненным.
          "anyRegExp": [
            "\\bпанд[ау]\\b"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Судя по всему, Вы хотите купить панду :)"
        }
      ]
    }
  ]
}
