// Пример файла автоматизации, который выполняет следующие действия:
// как только менеджер пишет клиенту сообщение, содержащие слова "заказ отправили",
// у заказа устанавливается статус "Отправлен".

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Если true, это исходящее сообщение (от менеджера клиенту).
          "isOut": true,
          // Словосочетания, которые должны содержаться в сообщении.
          // Для срабатывания правила автоматизации в сообщении может присутствовать любое
          // их словосочетаний.
          "anyWordsInMessage": [
            "заказ отправили"
          ]
        }
      ],
      "actions": [
        {
          // Статус заказа, который нужно установить.
          // Статус устанавливается у последнего заказа клиента.
          "type": "setOrderStatus",
          "orderStatus": {
            "name": "Отправлен"
          }
        }
      ]
    }
  ]
}
