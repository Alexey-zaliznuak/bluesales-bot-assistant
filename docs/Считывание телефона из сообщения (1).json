{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Реагируем на входящее сообщение от клиента.
          "isOut": false
        },
        // Проверяем, что поле "Мобильный телефон" пустое, чтобы
        // не заполнять его повторно.
        {
          "type": "customerFieldEquals",
          "fieldName": "Мобильный телефон",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Мобильный телефон",

          // Обозначает, что значение поля нужно получить из сообщения пользователя.
          "findInMessage": {
            // Указываем, что хотим найти в сообщении телефон.
            // Он может находиться в любой части сообщения.
            "phone": true
          }
        }
      ]
    }
  ]
}
