// Клиент или менеджер пишет любое сообщение => отправляем
// клиенту сообщение "У вас крупный заказ.", если в поле "Размер"
// у заказа стоит значение "Крупный".

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage"
        },
        {
          // Проверяем значение поля "Размер" у заказа.
          // Если в поле содержится значение "Крупный", правило срабатывает.
          "type": "orderFieldEquals",
          "fieldName": "Размер",
          "valueAsText": "Крупный"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "У вас крупный заказ."
        }
      ]
    }
  ]
}
