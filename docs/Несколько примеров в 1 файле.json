// Это пример файла с настройками правил автоматизации.
// Файл должен иметь формат JSON приведенного ниже формата.
// Для редактирования файла удобнее всего использовать редактор вроде Notepad++ (он бесплатный).

{
  // Набор правил автоматизации.
  // Их может быть сколько угодно.
  "automationRules": [
    {
      // Раздел, в котором задаются условия.
      "conditions": [
        {
          // Тип условия.
          // "newMessage" означает новое сообщение в сообщениях сообщества,
          // как входящее, так и исходящее.
          "type": "newMessage",
          // Если true, это исходящее сообщение.
          // Если false, это входящее сообщение.
          "isOut": true,
          // Группы ВК / ОК, страницы Instagram, номера WhatsApp или боты Telegram,
          // на сообщения в которых мы реагируем.
          // Если правило должно действовать для любых групп,
          // свойство channels можно не указывать.
          "channels": [
            {
              // Тип канала: "vkGroup", "okGroup", "instagram", "whatsApp", "telegram".
              // Группа ВК.
              "type": "vkGroup",
              // Для ВК и Одноклассников нужно указывать id группы.
              "id": "114745703"
            },
            {
              // Группа ОК.
              "type": "okGroup",
              "id": "53966610825295"
            },
            // Страница Instagram.
            {
              "type": "instagram",
              // Тут указываем логин страницы Instagram.
              "id": "bracelets_symphony"
            },
            // Номер WhatsApp (работает только при подключении номера WhatsApp в мессенджер BlueSales).
            {
              "type": "whatsApp",
              // Тут указываем номер телефона WhatsApp, именно в таком формате.
              "id": "79161234567"
            },
            // Бот Telegram.
            {
              "type": "telegram",
              "id": "MySuperBot"
            },
            // Личный аккаунт Telegram.
            {
              "type": "telegramPersonal",
              // Номер телефона, строго в таком формате.
              "id": "79161234567"
            },
            // Номер Max.
            {
              "type": "max",
              // Номер телефона, строго в таком формате.
              "id": "79161234567"
            },
            // Профиль Авито.
            // Числовой id можно найти на странице настроек профиля Авито в разделе:
            // Настройки / Соцсети / Авито
            {
              "type": "avito",
              "id": "29312883"
            }
          ],
          // Словосочетания, которые должны содержаться в сообщении.
          // Для срабатывания правила автоматизации в сообщении может присутствовать любое
          // их словосочетаний.
          "anyWordsInMessage": [
            "добрый день",
            "добрый вечер"
          ],
          // Все словосочетания, перечисленные в этом свойстве, должны присутствовать
          // в сообщении, чтобы правило автоматизации сработало.
          "allWordsInMessage": null
        }
      ],
      // Действия, которые будут выполнены, если условия, перечисленные выше, сработают.
      "actions": [
        {
          // Установка определенного статуса CRM.
          "type": "setCrmStatus",
          // CRM-статус, который нужно установить.
          "crmStatus": {
            "name": "Ожидаем оплату"
          }
        },
        // Тэг, который нужно добавить.
        // Можно указать несколько тэгов.
        {
          "type": "setTagsAction",
          "addTags": [
            {
              "name": "VIP-клиент"
            }
          ],
          "removeTags": [
            {
              "name": "Реклама"
            },
            {
              "name": "Маркетинг"
            }
          ]
        },
        // Установить дату следующего контакта.
        {
          "type": "setNextContactDate",
          // Через сколько дней напоминание установить.
          "daysFromToday": 3,
          // Если true, обнулит дату следующего контакта.
          "setNextContactDateToNull": false
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false,

          // Группу ВК вообще не указываем.
          // В этом случае правило будет работать для всех групп ВК.

          "anyWordsInMessage": [
            "оплатил"
          ]
        }
      ],
      "actions": [
        {
          "type": "setTags",
          "addTags": [
            {
              "name": "Проверить оплату"
            }
          ]
        }
      ]
    },
    // Установили тэг "VIP" => меняем дату первого контакта на Сегодня и устанавливаем Источник.
    {
      "conditions": [
        {
          // Событие изменения тэгов у клиента.
          "type": "tagsChanged",
          // Тэги, которые были добавлены.
          "addedTags": [
            {
              "name": "VIP"
            }
          ],
          // Тут можно указать набор тэгов, которые были удалены.
          "removedTags": null
        }
      ],
      // Действия, которые будут выполнены, если условия, перечисленные выше, сработают.
      "actions": [
        {
          // Изменение даты первого контакта.
          "type": "setFirstContactDate",
          "daysFromToday": 0
        },
        {
          // Установка поля "Источник" клиента.
          "type": "setSource",
          "source": {
            "name": "Узнал от друга"
          }
        }
      ]
    }
  ]
}
