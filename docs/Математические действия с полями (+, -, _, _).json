// В данном боте демонстрируются математические операции с числовыми полями.
// Для работы бота необходимо создать числовое поле с названием "Число" в разделе
// Настройки / Поля / Клиенты.
// Бот работает следующим образом:
// 1) Если клиент отправит "+", к значению поля "Число" будет прибавлено 5.
// 2) Если клиент отправит "-", из значения поля будет вычтено значение 5.
// 3) Если клиент отправит "*", значение поля будет увеличено в 2 раза.
// 4) Если клиент отправит "/", значение поля будет уменьшено в 2 раза.
// После каждой из этих операций бот отправит клиенту сообщение с новым значением поля.

{
  "automationRules": [
    {
      "conditions": [
        {
          // Событие отправки клиенту сообщения с текстом "+".
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "+"
          ]
        }
      ],
      "actions": [
        {
          // Смена значения поля клиента.
          // Если нужно изменить значение поля заказа, нужно указать "type": "setOrderField".
          "type": "setCustomerField",
          "fieldName": "Число",
          // Математическая операция с полем "Число".
          "math": {
            // Поддерживаются операции: "+", "-", "*", "/".
            "operator": "+",
            // Число, которое нужно прибавить к значению поля.
            "value": 5
          }
        },
        {
          "type": "sendMessage",
          "message": "Число увеличено на 5 и равно [Клиент.Число]."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "-"
          ]
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Число",
          "math": {
            "operator": "-",
            "value": 5
          }
        },
        {
          "type": "sendMessage",
          "message": "Число уменьшено на 5 и равно [Клиент.Число]."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "*"
          ]
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Число",
          "math": {
            "operator": "*",
            "value": 2
          }
        },
        {
          "type": "sendMessage",
          "message": "Число умножено на 2 и равно [Клиент.Число]."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "/"
          ]
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Число",
          "math": {
            "operator": "/",
            "value": 2
          }
        },
        {
          "type": "sendMessage",
          "message": "Число поделено на 2 и равно [Клиент.Число]."
        }
      ]
    }
  ]
}
