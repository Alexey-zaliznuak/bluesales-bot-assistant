// Пример бота, проверяющего статус заказа клиента.
// Бот работает следующим образом: если клиент присылает сообщение, содержащее
// ключевые слова "статус заказа", бот проверяет статус последнего заказа клиента
// и в зависимости от значения статуса отправляет клиенту то или иное сообщение.

{
  "automationRules": [
    {
      "conditions": [
        // Входящее сообщение от клиента, содержащее слова "статус заказа".
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "статус заказа"
          ]
        },
        // Проверяем, что у заказа статус "Отправлен".
        // Бот проверяет статус последнего заказа клиента.
        {
          "type": "orderStatusEquals",
          "name": "Отправлен"
        }
      ],
      // Отправляем клиенту сообщение.
      "actions": [
        {
          "type": "sendMessage",
          "message": "Ваш заказ был отправлен."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "статус заказа"
          ]
        },
        // Проверяем, что у заказа статус "Доставлен".
        {
          "type": "orderStatusEquals",
          "name": "Доставлен"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Ваш заказ уже был доставлен."
        }
      ]
    }
  ]
}
