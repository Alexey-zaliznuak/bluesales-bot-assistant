// После установки клиенту статуса "Ожидаем оплату" бот пишет сообщение
// менеджеру через заданный интервал (например, 2 часа) и напоминает проверить оплату.
// В сообщении менеджеру бот отправляет ссылку на клиента.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "crmStatusChanged",
          "newStatus": {
            "name": "Ожидаем оплату"
          }
        }
      ],
      "actions": [
        {
          "type": "addFutureAction",
          "delay": {
            // Можно указать дни, часы, минуты и секунды.
            // Ненужные компоненты можно не указывать.
            "days": 0,
            "hours": 0,
            "minutes": 0,
            // В данном примере уведомление отправляется через 5 секунд; для реальной работы
            // интервал можно установить равным 2 часам, например.
            "seconds": 5
          },
          "actions": [
            {
              "type": "sendMessage",
              "message": "Напомнить клиенту [Клиент.ФИО] об оплате:\r\n\r\nhttps://bluesales.ru/app/Customers/CustomerView.aspx?id=[Клиент.Id]",

              // В свойстве "to" можно указать контакты менеджера / администратора, кому нужно
              // отправить сообщение.
              // Если свойство "to" не заполнено, сообщение по умолчанию отправляется клиенту.
              "to": {
                // Канал, от имени которого будет отправлено сообщение менеджеру / администратору.
                // Канал должен быть подключен к BlueSales.
                "channel": {
                  // Тип канала: "vkGroup", "okGroup", "instagram", "whatsApp",
                  // "telegram" (бот Telegram), "telegramPersonal" (номер Telegram).
                  "type": "vkGroup",
                  // Для групп ВК и ОК нужно указать числовой id группы.
                  // Для Instagram нужно указать числовой id страницы Instagram.
                  // Для номеров WhatsApp и Telegram нужно указать номер в формате "79161234567".
                  // Для ботов Telegram нужно указать числовой id бота.
                  // Для получения числового id вы можете написать в сообщения группы BlueSales.
                  "id": "114745703"
                },
                // Числовой id или телефон (в случае номеров WhatsApp или Telegram) менеджера / администратора.
                // Чтобы отправить сообщение в чат группы ВК, нужно указать ее id в формате "2000000001", "2000000002" и т. д.
                // (последняя цифра является номером группового чата).
                "id": "289832607"
              }
            }
          ]
        }
      ]
    }
  ]
}
