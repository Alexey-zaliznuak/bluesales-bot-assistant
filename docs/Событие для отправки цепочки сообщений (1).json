// Пример файла автоматизации, где мы генерируем вручную событие, которое
// создает цепочку отложенных сообщений.

// В данном случае цепочка сообщений отправляется клиенту в 2 случаях:
// 1) Если он написал "да".
// 2) Если менеджер установил клиенту тэг "Цепочка".

// Удобство использования события тут заключается в том, что мы задаем структуру
// цепочки сообщений только 1 раз, и далее для отправки клиенту цепочки сообщений
// нам достаточно вызвать событие, причем это можно делать несколько раз, из разных частей файла.

{
  "automationRules": [
    // Клиент пишет "да" => вызываем событие "sendDelayedMessages".
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "callEvent",
          "name": "sendDelayedMessages"
        }
      ]
    },
    // У клиента установлен тэг "Цепочка" => вызываем событие "sendDelayedMessages".
    {
      "conditions": [
        {
          "type": "tagsChanged",
          "addedTags": [
            {
              "name": "Цепочка"
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "callEvent",
          "name": "sendDelayedMessages"
        }
      ]
    },

    // Тут мы определяем, какой набор действий будет выполнен при возникновении события "sendDelayedMessages".
    // В данном случае мы отправляем клиенту 2 отложенных сообщения.
    {
      "conditions": [
        {
          "type": "eventCalled",
          "name": "sendDelayedMessages"
        }
      ],
      "actions": [
        // Первое сообщение, через 5 секунд.
        {
          "type": "addFutureAction",
          "delay": {
            "seconds": 5
          },
          "message": "[Имя], ждем от Вас оплату :)"
        },
        // Второе сообщение, через 10 секунд.
        {
          "type": "addFutureAction",
          "delay": {
            "seconds": 10
          },
          "message": "[Имя], подскажите, удалось ли Вам оплатить заказ?"
        }
      ]
    }
  ]
}
