// Пример, демонстрирующий использование произвольных событий в правилах автоматизации BlueSales.

// Событие может быть сгенерировано одним из следующих способов:

// 1) Как действие в правилах автоматизации.
// Например: клиент написал "да" => вызываем событие с кодовым названием "sayHello".
// В данном файле приведен как раз такой пример.

// 2) Событие можно также сгенерировать путем обращения к методу API BlueSales bots.callEvent.
// При этом методу API надо передать JSON такого формата:
// {
//     "name": "sayHello",
//     "channelType": "vkGroup",
//     "shopSocialId": "114745701",
//     "customerSocialId": "289832601"
// }
// Данный метод API генерирует событие "sayHello" для клиента ВК с VK id = "289832601"
// и перепиской в группе ВК с id = "114745701".
// Указание группы ВК требуется в том случае, если в ответ на событие необходимо
// отправить клиенту сообщение (оно будет отправлено именно в указанную группу).

{
  "automationRules": [
    // Если клиент пишет нам сообщение со словом "здравствуйте",
    // генерируем событие "sayHello".
    // При этом приведенные ниже в данном файле правила автоматизации
    // в ответ на возникновения события "sayHello" отправляют клиенту
    // сообщение с приветствием.
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "здравствуйте"
          ]
        }
      ],
      "actions": [
        {
          // Вызываем событие "sayHello".
          "type": "callEvent",
          "name": "sayHello"
        }
      ]
    },

    // Если клиент пишет нам "привет", мы также вызываем событие "sayHello",
    // чтобы бот поздоровался с клиентом.
    // Таким образом, мы можем сколько угодно раз вызывать событие "sayHello",
    // и это будет вызывать определенный набор действий.
    // Это похоже на функции / процедуры в языках программирования: логика функции пишется
    // 1 раз, а после этого ее можно вызывать из разных частей программы.
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "привет"
          ]
        }
      ],
      "actions": [
        {
          // Вызываем событие с кодовым названием "sayHello".
          // Для названий событий можно использовать любые буквы / цифры и даже пробелы,
          // ограничений никаких нет.
          "type": "callEvent",
          "name": "sayHello"
        }
      ]
    },

    // Тут мы реагируем на возникновение события "sayHello" и
    // здороваемся с клиентом в ответ на возникновение события.
    {
      "conditions": [
        // Возникновение события с кодовым названием "sayHello".
        {
          "type": "eventCalled",
          "name": "sayHello"
        },
        // Проверяем время. Если время от 6 до 12 утра, пишем клиенту "Доброе утро!".
        {
          "type": "timeEquals",
          "from": "6:00",
          "till": "12:00"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "[Имя], доброе утро!"
        }
      ]
    },
    {
      // Если возникло событие "sayHello" и при этом время от 12:01 до 18:00,
      // пишем клиенту "Добрый день!".
      "conditions": [
        {
          "type": "eventCalled",
          "name": "sayHello"
        },
        {
          "type": "timeEquals",
          "from": "12:01",
          "till": "18:00"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "[Имя], добрый день!"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "eventCalled",
          "name": "sayHello"
        },
        {
          "type": "timeEquals",
          "from": "18:01",
          "till": "23:59"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "[Имя], добрый вечер!"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "eventCalled",
          "name": "sayHello"
        },
        {
          "type": "timeEquals",
          "from": "0:00",
          "till": "5:59"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "[Имя], доброй ночи!"
        }
      ]
    }
  ]
}
