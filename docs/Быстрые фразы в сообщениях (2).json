{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          // Таким образом можно включать в сообщения целые быстрые фразы.
          // Синтаксис: [Фраза.Название фразы].
          "message": "[Имя], добрый день!\n\n[Фраза.Товар есть в наличии]\n\n[Фраза.Доставка бесплатная]"
        }
      ]
    }
  ]
}