// Данное правило автоматизации работает следующим образом:
// 1) Клиент пишет любое сообщение.
// 2) Бот с вероятностью 50% отвечает клиенту "Орел" и с вероятностью 50% отвечает "решка".

{
  "automationRules": [
    {
      "conditions": [
        {
          // Реагируем на любое входящее сообщение от клиента (текст роли не играет).
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false
        }
      ],
      "actions": [
        {
          // Случайное действие.
          "type": "random",
          // Вероятность выполнения случайного действия: от 0 до 1.
          // В данном случае 0.5, то есть 50%.
          "probability": "0.5",
          // Действия, которые нужно выполнить, если случайное событие сработало.
          // В данном случае мы только отправляем клиенту сообщение с определенным текстом,
          // но набор действий может быть любым: установка статуса клиента, тэгов, полей и т. д.
          "actions": [
            {
              "type": "sendMessage",
              "message": "Орел :)"
            }
          ],
          // Действие, которые нужно выполнить, если случайное событие не сработало.
          // Данный раздел можно вообще не создавать, тогда никакие действия в случае
          // нереализации случайного события выполняться не будут.
          "elseActions": [
            {
              "type": "sendMessage",
              "message": "Решка :)"
            }
          ]
        }
      ]
    }
  ]
}
