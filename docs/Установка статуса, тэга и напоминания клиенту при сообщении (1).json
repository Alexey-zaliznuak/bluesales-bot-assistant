// Пример файла автоматизации, который выполняет следующие действия:

// 1) Как только менеджер пишет клиенту сообщение, содержащие слова "вот реквизиты на оплату",
// устанавливается статус CRM клиента "Ожидаем оплату" и напоминание на дату через 3 дня.

// 2) Как только клиент пишет сообщение со словами "оплатил" или "оплату произвел",
// напоминание удаляется и ставится тэг "Проверить оплату".

{
  "automationRules": [
    {
      "conditions": [
        {
          // Тип условия.
          // "newMessage" означает новое сообщение в сообщениях сообщества,
          // как входящее, так и исходящее.
          "type": "newMessage",
          // Если true, это исходящее сообщение.
          // Если false, это входящее сообщение.
          // Если свойство не указывать, правило автоматизации будет реагировать как на входящие,
          // так и на исходящие сообщения.
          "isOut": true,
          // Группы ВК / ОК, страницы Instagram, номера WhatsApp или боты Telegram,
          // на сообщения в которых мы реагируем.
          // Если правило должно действовать для любых групп,
          // свойство channels можно не указывать.
          "channels": [
            {
              // Тип канала: "vkGroup", "okGroup", "instagram", "whatsApp",
              // "telegram" (бот Telegram), "telegramPersonal" (личный номер Telegram).
              // Группа ВК.
              "type": "vkGroup",
              // Для ВК и Одноклассников нужно указывать id группы.
              "id": "114745703"
            },
            {
              // Группа ОК.
              "type": "okGroup",
              "id": "53966610825295"
            },
            // Страница Instagram.
            {
              "type": "instagram",
              // Тут указываем логин страницы Instagram.
              "id": "bracelets_symphony"
            },
            // Номер WhatsApp (работает только при подключении номера WhatsApp в мессенджер BlueSales).
            {
              "type": "whatsApp",
              // Тут указываем номер телефона WhatsApp, именно в таком формате.
              "id": "79161234567"
            },
            // Бот Telegram.
            {
              "type": "telegram",
              "id": "MySuperBot"
            },
            // Личный аккаунт Telegram.
            {
              "type": "telegramPersonal",
              // Номер телефона, строго в таком формате.
              "id": "79161234567"
            },
            // Номер Max.
            {
              "type": "max",
              // Номер телефона, строго в таком формате.
              "id": "79161234567"
            },
            // Профиль Авито.
            // Числовой id можно найти на странице настроек профиля Авито в разделе:
            // Настройки / Соцсети / Авито
            {
              "type": "avito",
              "id": "29312883"
            }
          ],
          // Словосочетания, которые должны содержаться в сообщении.
          // Для срабатывания правила автоматизации в сообщении может присутствовать любое
          // их словосочетаний.
          "anyWordsInMessage": [
            "вот реквизиты на оплату"
          ],
          // Все словосочетания, перечисленные в этом свойстве, должны присутствовать
          // в сообщении, чтобы правило автоматизации сработало.
          "allWordsInMessage": null
        }
      ],
      // Действия, которые будут выполнены, если условия, перечисленные выше, сработают.
      "actions": [
        {
          // CRM-статус, который нужно установить.
          "type": "setCrmStatus",
          "crmStatus": {
            "name": "Ожидаем оплату"
          }
        },
        // Установить дату следующего контакта.
        {
          "type": "setNextContactDate",
          // Через сколько дней напоминание установить.
          "daysFromToday": 3,
          // Если true, обнулит дату следующего контакта.
          "setNextContactDateToNull": false
        }
      ]
    },
    {
      "name": "Клиент написал, что оплатил => ставим тэг 'Проверить оплату'",
      "conditions": [
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false,

          // Группы ВК / ОК или страницы Instagram вообще не указываем.
          // В этом случае правило будет работать для всех групп.

          "anyWordsInMessage": [
            // Тут разные варианты, какие словосочетания в сообщении клиента
            // могут означать, что он произвел оплату.
            "оплатил",
            "произвел оплату",
            "деньги перевел"
          ]
        }
      ],
      "actions": [
        {
          "type": "setTags",
          "addTags": [
            {
              "name": "Проверить оплату"
            }
          ]
        },
        {
          "type": "setNextContactDate",
          // Обнуляем дату следующего контакта после того, как клиент
          // написал, что он произвел оплату.
          "setNextContactDateToNull": true
        }
      ]
    }
  ]
}
