// Файл выполняет следующие действия:

// 1) При отправке клиенту сообщения "Просьба поскорее оплатить заказ" в поле-мультисписок "Отправленные сообщения"
// добавляется значение "Оплатите 1".

// 2) При отправке клиенту сообщения "Будем благодарны, если вы сможете оплатить заказ уже сегодня"
// в поле-мультисписок "Отправленные сообщения" добавляется значение "Оплатите 2".

// Таким образом, в поле "Отправленные сообщения" в карточке клиента будет фиксироваться, какие сообщения
// отправлялись клиенту, и это можно далее использовать для анализа эффективности различных скриптов.

// Поле "Отправленные сообщения" типа "Мульти-список" нужно добавить в разделе Настройки / Поля / Клиенты и
// установить набор возможных его значений (в данном случае это "Оплатите 1", "Оплатите 2").

{
  "automationRules": [
    {
      "conditions": [
        {
          // Тип условия.
          // "newMessage" означает новое сообщение в сообщениях сообщества,
          // как входящее, так и исходящее.
          "type": "newMessage",
          // Если true, это исходящее сообщение.
          // Если false, это входящее сообщение.
          "isOut": true,
          // Группы ВК / ОК, страницы Instagram, номера WhatsApp или боты Telegram,
          // на сообщения в которых мы реагируем.
          // Если правило должно действовать для любых групп,
          // свойство channels можно не указывать.
          "channels": [
            {
              // Тип канала: "vkGroup", "okGroup", "instagram", "whatsApp", "telegram".
              // Группа ВК.
              "type": "vkGroup",
              // Для ВК и Одноклассников нужно указывать id группы.
              "id": "114745703"
            },
            {
              // Группа ОК.
              "type": "okGroup",
              "id": "53966610825295"
            },
            // Страница Instagram.
            {
              "type": "instagram",
              // Тут указываем логин страницы Instagram.
              "id": "bracelets_symphony"
            },
            // Номер WhatsApp (работает только при подключении номера WhatsApp в мессенджер BlueSales).
            {
              "type": "whatsApp",
              // Тут указываем номер телефона WhatsApp, именно в таком формате.
              "id": "79161234567"
            },
            // Бот Telegram.
            {
              "type": "telegram",
              "id": "MySuperBot"
            },
            // Личный аккаунт Telegram.
            {
              "type": "telegramPersonal",
              // Номер телефона, строго в таком формате.
              "id": "79161234567"
            },
            // Номер Max.
            {
              "type": "max",
              // Номер телефона, строго в таком формате.
              "id": "79161234567"
            },
            // Профиль Авито.
            // Числовой id можно найти на странице настроек профиля Авито в разделе:
            // Настройки / Соцсети / Авито
            {
              "type": "avito",
              "id": "29312883"
            }
          ],
          // Словосочетания, которые должны содержаться в сообщении.
          // Для срабатывания правила автоматизации в сообщении может присутствовать любое
          // их словосочетаний.
          "anyWordsInMessage": [
            "Просьба поскорее оплатить заказ"
          ]
        }
      ],
      // Действия, которые будут выполнены, если условия, перечисленные выше, сработают.
      "actions": [
        // Добавление / удаление отдельных значений для полей
        // типа "Мульти-список".
        {
          "type": "setCustomerField",
          "fieldName": "Отправленные сообщения",
          // Так можно добавить новое значение к существующему мультисписку.
          // Важно, чтобы это было одно из допустимых значений мультисписка,
          // заданных в разделе Настройки / Поля / Клиенты.
          "addValueAsText": "Оплатите 1"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": true,
          "anyWordsInMessage": [
            "Будем благодарны, если вы сможете оплатить заказ уже сегодня"
          ]
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Отправленные сообщения",
          "addValueAsText": "Оплатите 2"
        }
      ]
    }
  ]
}
