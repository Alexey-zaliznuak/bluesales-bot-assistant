// Пример бота, который автоматически считывает e-mail, который содержится
// в сообщении клиента, и сохраняет его в системное поле "E-mail" в карточке клиента,
// если это поле еще не заполнено.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Реагируем на входящее сообщение от клиента.
          "isOut": false
        },
        // Проверяем, что поле "E-mail" пустое, чтобы
        // не заполнять его повторно.
        {
          "type": "customerFieldEquals",
          "fieldName": "E-mail",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "E-mail",

          // Обозначает, что значение поля нужно получить из сообщения пользователя.
          "findInMessage": {
            // Указываем, что хотим найти в сообщении e-mail.
            // Он может находиться в любой части сообщения.
            "email": true
          }
        }
      ]
    }
  ]
}
