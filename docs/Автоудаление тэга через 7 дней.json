// Данный файл автоматизации содержит пример автоудаления тэга через 7 дней:
// после установки клиенту тэга "Скидка" через 7 дней он автоматически удаляется.

// Логика тут может быть следующей: после того, как клиент совершил первую покупку,
// можно сообщать ему, что в случае, если в течение 7 дней он совершит еще одну покупку,
// ему будет предоставлена скидка в размере 20%.

// Тэг "Акция" у клиента будет означать, что он имеет право на эту скидку.
// По истечении 7 дней данный тэг будет автоматически удаляться.

{
  "automationRules": [
    {
      // Правило включаем после установки клиенту тэга "Скидка".
      "conditions": [
        {
          "type": "tagsChanged",
          "addedTags": [
            {
              "name": "Скидка"
            }
          ]
        }
      ],
      "actions": [
        {
          // Добавляем отложенное действие (после того как установлен тэг "Скидка").
          "type": "addFutureAction",
          "delay": {
            // Действие будет выполнено через 7 дней.
            // Для целей тестирования тут можно указать "seconds": 7,
            // чтобы действие срабатывало через 7 секунд
            // (может иметь место задержка до 10 секунд, но для длинных интервалов это не критично).
            "days": 7
          },
          // По истечении заданного временного интервала будут совершены
          // действия, перечисленные в данном разделе.
          "actions": [
            // Удаляем тэг "Скидка".
            {
              "type": "removeTag",
              "name": "Скидка"
            }
          ]

          // При желании сюда можно также добавить раздел "conditions", чтобы по истечении
          // заданного интервала проверять дополнительные условия перед удалением тэга.
          // Например, можно проверять статус клиента, и удалять тэг только
          // в случае, если у клиента стоит определенный статус.
        }
      ]
    }
  ]
}
