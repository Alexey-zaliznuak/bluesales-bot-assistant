// Файл настроек правил автоматизации BlueSales, который после создания нового
// клиента автоматически заполняет ряд его полей.

{
  "automationRules": [
    {
      "conditions": [
        {
          // Тип условия.
          // "customerAdded" означает сохранение нового клиента (любым способом: это может быть
          // через плагин, админку BlueSales или через механизм автоматического сохранения).
          "type": "customerAdded"
        }
      ],
      // Действия, которые необходимо выполнить.
      // В данном случае мы устанавливаем значения для ряда дополнительных полей.
      // Чтобы данный пример работал, все перечисленные ниже поля должны быть
      // настроены для клиента (в разделе Настройки / Поля / Клиенты).
      "actions": [
        // Поле типа "Флаг".
        {
          "type": "setCustomerField",
          "fieldName": "VIP-клиент",
          "valueAsText": "Да"
        },
        // Поле типа "Текст" или "Текстовая область".
        {
          "type": "setCustomerField",
          "fieldName": "Марка телефона",
          "valueAsText": "Samsung"
        },
        // Поле типа "Число".
        {
          "type": "setCustomerField",
          "fieldName": "Количество заказов",
          "valueAsText": "3"
        },
        // Поле типа "Дата".
        {
          "type": "setCustomerField",
          "fieldName": "Дата",
          "valueAsText": "31.12.2018"
        },
        // Поле типа "Время".
        {
          "type": "setCustomerField",
          "fieldName": "Время",
          "valueAsText": "21:05"
        },
        // Поле типа "Дата и время".
        {
          "type": "setCustomerField",
          "fieldName": "Дата и время",
          "valueAsText": "31.12.2018 19:00"
        },
        // Поле типа "Список".
        {
          "type": "setCustomerField",
          "fieldName": "Список",
          "valueAsText": "Апельсин"
        },
        // Поле типа "Мультисписок".
        {
          "type": "setCustomerField",
          "fieldName": "Мультисписок",
          // Набор значений полей передается через запятую.
          "valueAsText": "Гамбургер, Картошка"
        }

        // Установка значений для стандартных полей клиента пока недоступна,
        // кроме Статуса CRM, Даты следующего контакта и Источника (для этого существуют
        // отдельные actions, см. другие примеры).
      ]
    }
  ]
}
