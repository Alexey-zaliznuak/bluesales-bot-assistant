// Пример бота, который проверяет значение метки ref, которая приходит от ВК.
// Предполагается, что 2 разных таргетолога настраивают рекламу в группе ВК,
// и каждый из них использует ссылки со своими метками ref.
// В этом случае по метке ref можно определить таргетолога и сохранить его ФИО
// в дополнительное поле "Таргетолог" в карточке клиента.

// Метка передается, если клиент перешел в сообщения группы ВК
// по ссылке следующего вида и написал сообщение:
// https://vk.com/write-86155313?ref=test1
// Более детально механизм работы с метками описан в статье:
// https://vk.com/@bluesales-otslezhivanie-istochnika-perehoda-klienta

// Данный пример бота работает по следующему алгоритму:

// 1) Если от клиента приходит сообщение с меткой ref "test1" или "test2",
// бот сохраняет в поле "Таргетолог" клиента значение "Иван Петров"
// (в данном примере это таргетолог, в объявлениях которого используются ссылки с указанными метками ref).

// 2) Если от клиента приходит сообщение с меткой ref "test3" или "test4",
// в поле "Таргетолог" сохраняется значение "Сергей Андреев".

// Чтобы данный бот работал, необходимо создать текстовое поле "Таргетолог" в разделе:
// Настройки / Поля / Клиенты

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false,

          "ref": {
            // Метка ref содержит "test1" или "test2".
            "equalsAny": [
              "test1",
              "test2"
            ]

            // Метка содержит значение "test1".
            // "equals": "test1"

            // Метка содержит текстовый фрагмент "test" ("test123", "mytest" и т. д.)
            // "contains": "test"

            // Метка содержит текстовый фрагмент "test" или "ad".
            // "containsAny": [
            //   "test",
            //   "ad"
            // ]
          }

          // Можно также проверять метку ref_source,
          // используя параметр "refSource":

          // "refSource": {
          //   "equalsAny": [
          //     "test1",
          //     "test2"
          //   ]
          // }

          // Означает, что параметр ref не передан.
          // "isEmpty": true
        },
        // Проверяем, что поле "Таргетолог" еще не заполнено.
        {
          "type": "customerFieldEquals",
          "fieldName": "Таргетолог",
          "valueAsText": null
        }
      ],
      "actions": [
        // В доп. поле "Таргетолог" устанавливаем ФИО таргетолога.
        {
          "type": "setCustomerField",
          "fieldName": "Таргетолог",
          "valueAsText": "Иван Петров"
        }
      ]
    },

    {
      "conditions": [
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false,

          "ref": {
            // Метка ref содержит "test3" или "test4".
            "equalsAny": [
              "test3",
              "test4"
            ]
          }
        },
        // Проверяем, что поле "Таргетолог" еще не заполнено.
        {
          "type": "customerFieldEquals",
          "fieldName": "Таргетолог",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Таргетолог",
          "valueAsText": "Сергей Андреев"
        }
      ]
    }
  ]
}
