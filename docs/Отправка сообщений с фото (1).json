// Простой бот, в котором продемонстрировано, как отправлять несколько сообщений одновременно.
// Логика работы бота следующая:
// 1) Клиент пишет сообщение со словами "коала" или "коалу" => отправляем ему 2 сообщения:
// первое с фото, второе просто текстовое.
// 2) Клиент пишет "панда", "панду" => отправляем ему 2 сообщения.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            "коала",
            "коалу"
          ]
        }
      ],
      // Действия, которые необходимо выполнить при получении нового сообщения от клиента.
      // Тут мы отправляем 2 отдельных сообщения:
      // 1) Первое сообщение содержит вложение (фото).
      // 2) Второе сообщение идет просто с текстом.
      // Цель заключается в том, чтобы фотография была расположена между 2 сообщениями.
      "actions": [
        {
          "type": "sendMessage",
          "message": "У нас есть такая коала: [photo-114745703_422625932]"
        },
        {
          "type": "sendMessage",
          "message": "Питается укропом и петрушкой, стоит всего 25 тыс. руб. :-)"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "панда",
            "панду"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "У нас есть такая панда: [photo-114745703_456239466]"
        },
        {
          "type": "sendMessage",
          "message": "Стоит всего 35 тыс. руб. :-)"
        }
      ]
    }
  ]
}
