// Это пример файла с настройками правил автоматизации,
// который устанавливает клиенту определенный тэг в зависимости от того,
// какой менеджер BlueSales завел клиента.

{
  "automationRules": [
    // Правило 1: Менеджер BlueSales ivan@yandex.ru завел клиента => ставим тэг "ivan@yandex.ru".
    {
      // Раздел, в котором задаются условия.
      "conditions": [
        {
          // Тип условия.
          // "customerAdded" означает сохранение нового клиента (через плагин или через админку).
          "type": "customerAdded"
        },
        // Условие для проверки значения поля клиента.
        // В данном случае мы проверяем значение поля "Менеджер" у сохраненного клиента.
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер",
          // Логин менеджера в BlueSales.
          "valueAsText": "ivan@yandex.ru"
        }
      ],
      // Действия, которые необходимо выполнить, если сохранен клиент
      // с указанным выше менеджером.
      "actions": [
        // Установить тэг.
        {
          "type": "addTag",
          "name": "ivan@yandex.ru"
        }
      ]
    },

    // Правило 2: менеджер petrov@yandex.ru завел клиента => ставим тэг "petrov@yandex.ru".
    // Для дополнительных менеджеров нужно в аналогичном формате добавить
    // такие же разделы.
    {
      "conditions": [
        {
          "type": "customerAdded"
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер",
          "valueAsText": "petrov@yandex.ru"
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "petrov@yandex.ru"
        }
      ]
    }
  ]
}
