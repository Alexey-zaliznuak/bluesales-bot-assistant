// Бот выполняет следующие действия:

// 1) При вступлении клиента в группу ВК добавляется тэг "Вступил".

// 2) При выходе клиента из группы ВК добавляется тэг "Вышел".

{
  "automationRules": [
    {
      "conditions": [
        {
          // Событие вступления в группу ВК.
          "type": "groupJoin",
          // Группа ВК.
          // Если нужно реагировать на вступление в любую из групп ВК, подключенных
          // к BlueSales, свойство "channel" можно не указывать.
          "channel": {
            "type": "vkGroup",
            "id": 114745703
          }
        }
      ],
      "actions": [
        // При вступлении в группу устанавливаем тэг "Вступил".
        {
          "type": "addTag",
          "name": "Вступил"
        }
      ]
    },
    {
      "conditions": [
        {
          // Выход из группы ВК.
          "type": "groupLeave",
          "channel": {
            "type": "vkGroup",
            "id": 114745703
          }
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "Вышел"
        }
      ]
    }
  ]
}
