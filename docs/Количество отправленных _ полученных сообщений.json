// Данный бот фиксирует количество сообщений, полученных и отправленных клиенту.
// Необходимо создать 2 поля типа "Число" в разделе Настройки / Поля / Клиенты:
// 1) Получено сообщений
// 2) Отправлено сообщений
// При получении сообщения от клиента бот прибавляет 1 к значению поля "Получено сообщений",
// а при отправке сообщения клиенту бот увеличивает на 1 значение поля "Отправлено сообщений".

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": true
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          // Для произведения математических действий поле должно иметь тип "Число".
          "fieldName": "Отправлено сообщений",
          "math": {
            // Математический оператор: поддерживаются значения "+", "-", "/" и "*".
            "operator": "+",
            // Значение, которое нужно прибавить к значению поля.
            "value": 1
          }
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Получено сообщений",
          "math": {
            "operator": "+",
            "value": 1
          }
        }
      ]
    }
  ]
}
