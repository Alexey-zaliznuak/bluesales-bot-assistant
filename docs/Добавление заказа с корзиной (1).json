// Пример правила автоматизации, создающего заказ.
// Менеджер пишет "сейчас оформлю заказ" => система автоматически создает заказ
// с определенной корзиной.

{
  "automationRules": [
    {
      "conditions": [
        {
          "and": [
            {
              "type": "newMessage",
              "isOut": true,
              "anyWordsInMessage": [
                "сейчас оформлю заказ"
              ]
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "addOrder",
          "order": {
            // Указываем статус заказа.
            "orderStatus": {
              "name": "Доставлен"
            },
            // Корзина (набор позиций).
            "goodsPositions": [
              {
                "goods": {
                  // Название или артикул товара / услуги.
                  "name": "LS-083"
                },
                // Размер товара (указывать необязательно).
                "size": "13 см",
                "price": 799,
                "quantity": 2
              },
              {
                "goods": {
                  "name": "LS-100"
                },
                "size": "15 см",
                "price": 599,
                "quantity": 3
              }
            ]
          }
        }
      ]
    }
  ]
}
