{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "addFutureAction",
          "code": "Ц1",
          "delay": {
            "days": 0,
            "hours": 0,
            "minutes": 0,
            "seconds": 10,
			      // Время, в которое нужно будет выполнить будущее действие.
			      // Алгоритм работает так:
			      // 1) Сначала к текущей дате и времени прибавляются days, hours, minutes и seconds.
			      // 2) Затем у полученной даты устанавливается время atTime, при этом если
			      // время atTime окажется более ранним, то дата переносится на завтра.
            "atTime":  "11:58"
          },
          "message": "[Имя], Вы сможете оплатить 1000 рублей? :)"
        }
      ]
    }
  ]
}