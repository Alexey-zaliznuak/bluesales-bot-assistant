// Это пример файла с настройками правил автоматизации,
// который автоматически создает напоминание при изменении статуса CRM клиента
// на "Ожидаем оплату".

{
  "automationRules": [
    {
      "conditions": [
        {
          // Тип условия.
          "type": "crmStatusChanged",
          "newStatus": {
            "name": "Ожидаем оплату"
          },
          // В данном свойстве можно указать предыдущее значение статуса,
          // если нужно, чтобы правило автоматизации срабатывало строго при
          // смене статуса с одного значения на другое.
          // В данном случае мы указываем null, т. е. свойство не устанавливаем.
          "oldStatus": null
        }
      ],
      // Действия, которые необходимо выполнить при сохранении нового клиента.
      "actions": [
        // Установить дату следующего контакта (напоминания).
        {
          "type": "setNextContactDate",
          // Через сколько дней напоминание установить.
          "daysFromToday": 2,
          // Если true, обнулит дату следующего контакта.
          "setNextContactDateToNull": false
        }
      ]
    }
  ]
}
