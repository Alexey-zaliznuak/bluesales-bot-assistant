// Данный файл автоматизации работает следующим образом: после смены статуса заказа на "Отправлен"
// в поле "Дата отправки" заказа и клиента автоматически устанавливается текущая дата.

// Чтобы пример работал, необходимо создать у клиента и заказа дополнительное поле типа "Дата"
// с названием "Дата отправки" (в разделе Настройки / Поля).

{
  "automationRules": [
    {
      "conditions": [
        {
          // Событие изменения статуса заказа.
          "type": "orderStatusChanged",
          // Указываем название установленного статуса.
          // Если данное свойство не установить, условие будет срабатывать
          // при любом изменении статуса заказа.
          "newStatus": {
            "name": "Отправлен"
          }
        }
      ],
      "actions": [
        {
          // Установка значения поля Клиента.
          "type": "setCustomerField",
          // Название поля, значение которого нужно изменить.
          "fieldName": "Дата отправки",
          // Устанавливаем в поле-дату значение, отстоящее от текущей даты
          // на определенное количество дней: 0 = сегодня, 1 = завтра, -1 = вчера и т. д.
          "daysFromToday": 0
        },
        {
          // Установка значения поля Заказа.
          "type": "setOrderField",
          // Название поля.
          "fieldName": "Дата отправки",
          // Установка даты, отстоящей от текущей даты на определенное количество дней.
          // В данном случае 0 = сегодня.
          "daysFromToday": 0
        }
      ]
    }
  ]
}
