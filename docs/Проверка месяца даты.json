// Демонстрация проверки месяца даты.
// Бот работает следующим образом:
// 1) Клиент пишет любое сообщение.
// 2) Проверяем значение поля "Дата следующего контакта" (это может быть любое другое поле с датой):
// если дата в марте 2021, пишем клиенту сообщение.

{
  "automationRules": [
    {
      "conditions": [
        {
          // Реагируем на любое входящее сообщение от клиента.
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Дата следующего контакта",
          // Для полей-дат бот возвращает значения в формате "17 января 2021", "8 марта 2021" и т. д.
          // Здесь мы проверяем, что в текстовом представлении даты содержится текст "марта 2021",
          // т. е. любая дата в марте подойдет под этом условие.
          // Если нужно проверить, что дата относится к апрелю, тут нужно указать "апреля 2021", и т. д.
          "contains": {
            "text": "марта 2021"
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Дата в марте 2021 :)"
        }
      ]
    }
  ]
}
