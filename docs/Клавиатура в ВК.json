// Пример использования клавиатуры (кнопок) бота.

// Файл работает следующим образом:
// 1) Клиент пишет "да" в сообщество.
// 2) Сообщество задает ему вопрос, как у него дела, и отправляет
// набор кнопок для ответа.
// 3) Клиент нажимает на одну из кнопок ("Хорошо", "Плохо" или "Нормально").
// 4) Сообщество дает различный ответ в зависимости от нажатой кнопки.

// Чтобы пример работал, необходимо включить клавиатуру в сообществе:
// перейдите в раздел "Управление сообществом" → "Сообщения" → "Настройки для бота" и
// включите "Возможности ботов".

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Как у вас дела, [Имя]?",
          // Вместе с сообщением отправляем клиенту набор кнопок бота.
          // Формат данных о кнопках описан тут:
          // https://vk.com/dev/bots_docs_3
          "vkBotKeyboard": {
            // Если true, кнопки бота скрываются после того как клиент нажал на одну из них.
            // Если false, кнопки бота сохраняются.
            "one_time": true,
            "buttons": [
              [
                {
                  "action": {
                    "type": "text",
                    // Текст на кнопке (и это текст, который будет отправлен
                    // после нажатия на кнопку).
                    "label": "Хорошо"
                  },
                  // Цвет кнопки, допустимы следующие варианты:
                  // 1) "positive" = зеленая кнопка
                  // 2) "negative" = красная кнопка
                  // 3) "primary" = синяя кнопка
                  // 4) "secondary" = серо-голубая кнопка
                  "color": "positive"
                },
                {
                  "action": {
                    "type": "text",
                    "label": "Плохо"
                  },
                  "color": "negative"
                },
                {
                  "action": {
                    "type": "text",
                    "label": "Нормально"
                  },
                  "color": "secondary"
                }
              ]
            ]
          }
        }
      ]
    },
    // После нажатия на кнопку происходит отправка сообщения от клиента в группу.
    // Мы реагируем на текст сообщения (причем тут неважно, написал ли клиент
    // этот текст вручную или нажал на кнопку).
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessageWholeMatch": [
            // Клиент нажал на кнопку с текстом "хорошо" или набрал текст "хорошо".
            "хорошо"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Рады, что у вас все хорошо, [Имя] :)"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessageWholeMatch": [
            "нормально"
          ]
        }
      ]
    },
    {
      "actions": [
        {
          "type": "sendMessage",
          "message": "Рады, что у вас все в норме, [Имя] :)"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessageWholeMatch": [
            "плохо"
          ]
        }
      ]
    },
    {
      "actions": [
        {
          "type": "sendMessage",
          "message": "Желаем, чтобы настроение улучшилось, [Имя] :)"
        }
      ]
    }
  ]
}
