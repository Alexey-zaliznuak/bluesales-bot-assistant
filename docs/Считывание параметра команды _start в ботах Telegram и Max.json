// В данном примере демонстрируется, как можно считывать параметр
// команды /start в ботах Telegram и Max для отслеживания
// источника перехода клиента в бот.

// Для ботов Telegram можно создать ссылку такого рода:
// https://t.me/MyTestBot?start=Hello
// Для ботов Max ссылка имеет следующий вид:
// https://max.ru/id772970199848_bot?start=Hello

// Если клиент перейдет по данной ссылке и запустит процесс общения с ботом,
// в BlueSales будет передан параметр, указанный в ссылке (в примере выше это "Hello").
// Метка может содержать любые буквы и цифры, но не должна содержать пробелов.
// Эту метку можно использовать для отслеживания источника перехода клиента в бот.

// Приведенный ниже бот считывает значение переданного параметра и сохраняет его
// в поле клиента с названием "start".

// Чтобы данный пример работал, нужно:
// 1) Привязать бота Telegram или бота Max к BlueSales:
// Настройки / Соцсети / Telegram
// Настройки / Соцсети / Max
// 2) Создать текстовое поле клиента с названием "start" в разделе:
// Настройки / Поля / Клиенты

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Реагируем только на входящее сообщение от клиента.
          "isOut": false
        },
        // Проверяем, что поле "start" пустое, чтобы
        // не заполнять его повторно.
        {
          "type": "customerFieldEquals",
          "fieldName": "start",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          // Заполняем поле "start".
          "type": "setCustomerField",
          "fieldName": "start",

          "findInMessage": {
            // Специальное регулярное выражение, которое считывает из сообщения
            // параметр, переданный после команды "/start":
            // "/start Hello" => "Hello"
            // "/start 12345" => "12345"
            "regExp": "((?<=^\\/start )([\\wА-я-]+))"
          }
        }
      ]
    }
  ]
}
