// Пример отправки inline-клавиатуры через бота Telegram, а также использования режима
// форматирования сообщений.
// Для запуска бота нужно, чтобы клиент написал сообщение с текстом "фрукты и овощи",
// после чего ему будет отправлено сообщение с inline-клавиатурой.
// Далее, в зависимости от нажатия на различные клавиши клавиатуры, бот будет отправлять клиенту сообщения.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "фрукты и овощи"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          // Слово "*фрукт*" в сообщении будет выделено жирным, т. к. включен режим "Markdownv2".
          "message": "Какой *фрукт* или *овощ* вам больше нравится?",
          // Таким образом можно указать любые дополнительные параметры, которые
          // будут переданы методу sendMessage или sendPhoto Telegram Bot API.
          // Формат передачи параметров должен соответствовать документации Telegram Bot API.
          // Описание всех параметров можно найти по ссылке:
          // https://core.telegram.org/bots/api#sendmessage
          "telegramParameters": {
            // Данный параметр означает использование режима форматирования сообщения.
            // В этом случае в тексте сообщения можно использовать, например, "*фрукт*", чтобы
            // выделить слово жирным.
            // Полная документация по форматированию сообщений:
            // https://core.telegram.org/bots/api#markdownv2-style
            "parse_mode": "Markdownv2",
            // Отправка клиенту inline-клавиатуры бота.
            // Документация по клавиатуре ботов Telegram:
            // https://core.telegram.org/bots/api#inlinekeyboardmarkup
            "reply_markup": {
              "inline_keyboard": [
                // В данном примере у нас 2 ряда кнопок.
                // Ряд 1: 3 кнопки.
                [
                  {
                    // Текст кнопки.
                    "text": "Арбуз",
                    // Код кнопки: его нужно указывать, чтобы можно было распознавать,
                    // какую именно кнопку нажал клиент, и реагировать на это.
                    "callback_data": "fruit-watermelon"
                  },
                  {
                    "text": "Мандарин",
                    "callback_data": "fruit-mandarine"
                  },
                  {
                    "text": "Яблоко",
                    "callback_data": "fruit-apple"
                  }
                ],
                // Ряд 2: 2 кнопки.
                [
                  {
                    "text": "Картошка",
                    "callback_data": "vegetable-potato"
                  },
                  {
                    "text": "Помидор",
                    "callback_data": "vegetable-tomato"
                  }
                ]
              ]
            }
          }
        }
      ]
    },
    {
      "conditions": [
        // Событие нажатия на inline-кнопку клиентом.
        {
          "type": "buttonClicked",
          // Проверяем, что кнопка была нажата в диалоге с определенным ботом Telegram.
          // В данном случае перечислены 2 бота Telegram.
          // Если свойство channels не указывать, бот будет реагировать
          // на нажатие на кнопку в любом боте Telegram, подключенном к BlueSales.
          "channels": [
            {
              "type": "telegram",
              "id": "MySuperBot"
            },
            {
              "type": "telegram",
              "id": "AnotherSuperBot"
            }
          ],
          "data": {
            // Проверяем, что у нажатой кнопки код в точности "fruit-watermelon".
            "equals": "fruit-watermelon"
          }
        }
      ],
      "actions": [
        // В ответ на нажатие на кнопку "Арбуз" отправляем сообщение.
        {
          "type": "sendMessage",
          "message": "Вы выбрали арбуз."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "buttonClicked",
          "data": {
            // Свойство "contains" означает, что мы проверяем наличие в коде кнопки определенного фрагмента.
            // В данном случае условие сработает, если в коде кнопки имеется фрагмент "fruit". У нас
            // есть 3 кнопки с таким фрагментом: "fruit-watermelon", "fruit-mandarine", "fruit-apple",
            // и при нажатии на любую из них условие сработает.
            "contains": "fruit"
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Вы выбрали какой-то фрукт."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "buttonClicked",
          "data": {
            // Проверяем, что в коде кнопке имеется фрагмент "vegetable": у нас есть 2 кнопки с таким фрагментом.
            "contains": "vegetable"
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Вы выбрали какой-то овощ."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "buttonClicked",
          "data": {
            // Проверяем, что код нажатой кнопки в точности равен одному из перечисленных значений.
            "equalsAny": [
              "fruit-apple",
              "vegetable-tomato"
            ]
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Вы выбрали яблоко или помидор."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "buttonClicked",
          "data": {
            // Проверяем, что код нажатой кнопки включает один из перечисленных фрагментов.
            "containsAny": [
              "mandarine",
              "vegetable"
            ]
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Вы выбрали мандарин или какой-то овощ."
        }
      ]
    },
    {
      "conditions": [
        {
          // Здесь свойства "data" вообще нет, и мы проверяем только, что нажата какая-то из кнопок,
          // без проверки кода кнопки.
          "type": "buttonClicked"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Нажата какая-то из кнопок."
        }
      ]
    }
  ]
}
