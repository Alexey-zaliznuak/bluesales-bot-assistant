// Бот, который при смене статуса заказа на "Отправлен" отправит
// клиенту сообщение со ссылкой для отслеживания заказа СДЭК и адрес доставки.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "orderStatusChanged",
          "newStatus": {
            "name": "Отправлен"
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "[Имя], мы отправили Ваш заказ.\r\n\r\nОн будет доставлен по адресу: [Доставка.Адрес]\r\n\r\nЗа 1 час курьер позвонит Вам по номеру [Доставка.Телефон]\r\n\r\nВы можете отслеживать заказ по ссылке:\r\n\r\nhttps://www.cdek.ru/track.html?order_id=[Доставка.Номер отслеживания]"
        }
      ]
    }
  ]
}
