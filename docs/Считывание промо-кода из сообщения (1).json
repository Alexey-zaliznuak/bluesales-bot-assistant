// Бот демонстрирует автоматическое считывание промо-кода из сообщения от клиента
// и его сохранение в поле "Промо-код" в карточку клиента.
// Для работы бота нужно создать текстовое поле с названием "Промо-код" в разделе
// Настройки / Поля / Клиенты.
// Если клиент отправит сообщение, в тексте которого (в любом месте) содержится
// промо-код в формате "promo27168" или "promo12345" (начинающийся на "promo"),
// бот считает этот промо-код и сохранит его в поле "Промо-код" (если это поле еще на заполнено).
// Это удобно для автоматизации фиксации источника привлечения клиента.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Реагируем только на входящее сообщение от клиента.
          "isOut": false
        },
        // Проверяем, что поле "Промо-код" пустое, чтобы
        // не заполнять его повторно.
        {
          "type": "customerFieldEquals",
          "fieldName": "Промо-код",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          // Заполняем поле "Промо-код".
          "type": "setCustomerField",
          "fieldName": "Промо-код",

          // Обозначает получение значения из сообщения.
          "findInMessage": {
            // Ищем в сообщении первое слово, начинающееся на "promo",
            // например, "promo-28124" или "promo-jfivn".
            // Формат промо-кода может быть любым, но он должен иметь единый набор
            // символов в начале: например, "xyz81723", "xyz99281" и т. д.
            "wordStartingWith": "promo"
          }
        }
      ]
    }
  ]
}
