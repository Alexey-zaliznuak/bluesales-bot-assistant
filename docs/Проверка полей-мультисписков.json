// В данном файле приводится пример проверки наличия в
// поле клиента типа "Мультисписок" определенных значений.

// Чтобы пример работал, необходимо создать дополнительное поле
// типа "Мультисписок" с названием "Фрукты" и значениями:
// "Арбуз", "Дыня", "Мандарин", "Апельсин" (в разделе Настройки / Поля / Клиенты).

// Важно отметить, что свойство contains позволяет проверять наличие определенного текста
// в поле любого типа: например, проверить наличие текста "арбуз" в текстовом поле
// со значением "Клиент любит арбузы".

// Свойство contains можно использовать в условии "customerFieldEquals" (проверка полей клиента)
// и в условии "orderFieldEquals" (проверка полей заказов).

{
  "automationRules": [
    {
      "conditions": [
        // Реагируем на любое входящее сообщение от клиента.
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "customerFieldEquals",
          // Проверяем значение поля с названием "Фрукты".
          "fieldName": "Фрукты",
          "contains": {
            // Проверяем, что в поле имеется текст "арбуз" (регистр значения не имеет).
            // Таким образом можно проверять наличие текста в поле любого типа.
            // Например, если это обычное текстовое поле со значением "Клиент любит арбузы",
            // данное условие также сработает.

            // Важно также отметить, что значение поля-мультисписка преобразуется в текст
            // вида "Арбуз, Мандарин", и далее происходит обычный поиск слова "арбуз" в этом
            // тексте.
            // Поэтому если, например, в поле-мультисписке имеется элемент с названием
            // "Вкусные арбузы", данная проверка также сработает.
            "text": "арбуз"
          }
        }
      ],
      "actions": [
        // При выполнении условий происходит отправка сообщения клиенту.
        {
          "type": "sendMessage",
          "message": "В поле имеется текст / значение «арбуз»."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Фрукты",
          "contains": {
            // Проверяем, что в поле присутствует текст / элемент "арбуз" или "дыня"
            // (то есть либо "арбуз", либо "дыня", либо оба).
            "any": [
              "арбуз",
              "дыня"
            ]
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "В поле имеется текст / значение «арбуз» или «дыня»."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Фрукты",
          "contains": {
            // Проверяем, что в поле присутствует текст / значение "мандарин" и "апельсин" (оба значения).
            "all": [
              "мандарин",
              "апельсин"
            ]
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "В поле имеется текст / значение «мандарин» и «апельсин»."
        }
      ]
    }
  ]
}
