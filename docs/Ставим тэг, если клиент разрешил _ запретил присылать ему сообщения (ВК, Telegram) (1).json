// Пример работает следующим образом:

// 1) Как только клиент запрещает присылать ему сообщения от группы ВК,
// клиенту ставится тэг "Заблокировал (ВК)", и аналогично для бота Telegram ставится тэг
// "Заблокировал (Telegram)".

// 2) Как только клиент вновь разрешает присылать ему сообщения, удаляется тэг
// "Заблокировал (ВК)" и "Заблокировал (Telegram)", соответственно.

// Чтобы пример работал в ВК, следует убедиться, что в настройках Callback API группы ВК
// (Настройки / API / Callback API) на вкладке "Типы событий" стояли галки "Разрешение на получение"
// и "Запрет на получение" (достаточно поставить галки, ничего более нажимать не требуется).

{
  "automationRules": [
    // Блокировка / разблокировка сообщений в группе ВК.
    {
      "conditions": [
        {
          "type": "messageDeny",
          "channel": {
            "type": "vkGroup",
            "id": "114745703"
          }
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "Заблокировал (ВК)"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "messageAllow",
          "channel": {
            "type": "vkGroup",
            "id": "114745703"
          }
        }
      ],
      "actions": [
        {
          "type": "removeTag",
          "name": "Заблокировал (ВК)"
        }
      ]
    },
    // Блокировка / разблокировка сообщений в боте Telegram.
    {
      "conditions": [
        {
          "type": "messageDeny",
          "channel": {
            "type": "telegram",
            "id": "TestJune2021Bot"
          }
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "Заблокировал (Telegram)"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "messageAllow",
          "channel": {
            "type": "telegram",
            "id": "TestJune2021Bot"
          }
        }
      ],
      "actions": [
        {
          "type": "removeTag",
          "name": "Заблокировал (Telegram)"
        }
      ]
    }
  ]
}
