// Пример бота, который реализует нестандартный алгоритм распределения
// клиентов по менеджерам в зависимости от значения метки ref, которая приходит от ВК.

// Метка передается, если клиент перешел в сообщения группы ВК
// по ссылке следующего вида и написал сообщение:
// https://vk.com/write-86155313?ref=test1
// Более детально механизм работы с метками описан в статье:
// https://vk.com/@bluesales-otslezhivanie-istochnika-perehoda-klienta

// Данный пример бота работает по следующему алгоритму:

// 1) Если от клиента приходит сообщение с меткой ref "test1" или "test2", и менеджер
// у клиента не установлен, бот устанавливает одного из 3 менеджеров, с заданными вероятностями:
// Иванова, Петрова или Сидорова.

// 2) Если от клиента приходит сообщение с меткой ref "test3" или "test4",
// и менеджер у клиента еще не установлен, бот устанавливает одного из 2 других менеджеров:
// Смирнова или Волкова.

// 3) Наконец, если от клиента приходит сообщение без метки ref (то есть клиент не переходил
// по специальной ссылке с меткой, либо, перейдя по ссылке, не сразу написал сообщение),
// бот устанавливает менеджера Никитина, который, по задумке, является администратором
// и далее вручную распределяет клиентов нужному менеджеру.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false,
          // Метка ref содержит "test1" или "test2".
          "ref": {
            "equalsAny": [
              "test1",
              "test2"
            ]
          }
        },
        // Проверяем, что поле "Менеджер" еще не заполнено.
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          "type": "random",
          // Задаем установку менеджера случайным образом, с заданными вероятностями.
          // Сумма вероятностей должна быть равна 1; если это не так, бот
          // автоматически скорректирует значения вероятностей таким образом,
          // чтобы в сумме они были равны 1.
          // Например, если указать в качестве вероятностей значения 20 и 30,
          // бот превратит их в 0.4 и 0.6.
          "distribution": [
            {
              // Вероятность установки менеджера "ivanov@yandex.ru" равна 50%.
              "probability": 0.5,
              "actions": [
                {
                  "type": "setCustomerField",
                  "fieldName": "Менеджер",
                  // Указываем e-mail регистрации пользователя в BlueSales.
                  "valueAsText": "ivanov@yandex.ru"
                }
              ]
            },
            {
              "probability": 0.3,
              "actions": [
                {
                  "type": "setCustomerField",
                  "fieldName": "Менеджер",
                  "valueAsText": "petrov@yandex.ru"
                }
              ]
            },
            {
              "probability": 0.2,
              "actions": [
                {
                  "type": "setCustomerField",
                  "fieldName": "Менеджер",
                  "valueAsText": "sidorov@yandex.ru"
                }
              ]
            }
          ]
        }
      ]
    },

    // При приходе от клиента сообщения с меткой "test3" или "test4"
    // устанавливаем одного из 2 менеджеров.
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "ref": {
            "equalsAny": [
              "test3",
              "test4"
            ]
          }
        },
        // Проверяем, что поле "Менеджер" еще не заполнено.
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          "type": "random",
          "distribution": [
            {
              "probability": 0.2,
              "actions": [
                {
                  "type": "setCustomerField",
                  "fieldName": "Менеджер",
                  "valueAsText": "smirnov@yandex.ru"
                }
              ]
            },
            {
              "probability": 0.8,
              "actions": [
                {
                  "type": "setCustomerField",
                  "fieldName": "Менеджер",
                  "valueAsText": "volkov@yandex.ru"
                }
              ]
            }
          ]
        }
      ]
    },

    // В случае прихода от клиента сообщения без метки ref, устанавливаем
    // 1 конкретного менеджера: "nikitin@yandex.ru".
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "ref": {
            // Означает, что параметр ref не передан.
            "isEmpty": true
          }
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер",
          "valueAsText": null
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Менеджер",
          "valueAsText": "nikitin@yandex.ru"
        }
      ]
    }
  ]
}
