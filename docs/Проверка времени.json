// Данный файл автоматизации работает следующим образом: клиент пишет любое сообщение,
// и в зависимости от времени суток мы здороваемся с ним сообщением "Доброе утро!", "Добрый день!" и т. д.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          // Проверка времени события (сообщения) на нахождение в определенном интервале.
          "type": "timeEquals",
          // Временной интервал события: от 6:00 до 12:00 (включительно).
          // При проверке используется время события без секунд: например, если событие
          // произошло в 12:00:37, будет использоваться время "12:00".
          // Это означает, что если указать интервал от 6:00 до 12:00 и от 12:01 до 18:00,
          // событие, произошедшее в 12:00:37, попадает в первый интервал, а событие,
          // произошедшее в 12:01:17, попадет во второй интервал.
          // Таким образом, "дырок" между интервалами не будет.
          // Допустимо указывать только "from": в этом случае будет проведена проверка,
          // что время события больше, чем from, и меньше полуночи следующего дня (0:00).
          // Также можно указать только "till": в этом случае будет проведена проверка,
          // что время события меньше "till", но больше полуночи (0:00).
          "from": "6:00",
          "till": "12:00"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Доброе утро!"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "timeEquals",
          "from": "12:01",
          "till": "18:00"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Добрый день!"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "timeEquals",
          "from": "18:01",
          "till": "23:00"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Добрый вечер!"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          // Временной интервал с 23:01 до 5:59 утра.
          "type": "timeEquals",
          "from": "23:01",
          "till": "5:59"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Доброй ночи!"
        }
      ]
    }
  ]
}
