// Пример демонстрирует, как можно включать в сообщение поля из карточки клиента и из заказа.
// Клиент пишет "да", и в ответ ему отправляется сообщение с датой заказа и размером скидки.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          // Таким образом можно включать любые поля клиентов и заказов в сообщения.
          // Синтаксис: [Клиент.Название поля] и [Заказ.Название поля].
          // Поддерживаются как стандартные поля, так и дополнительные.
          "message": "[Имя], мы отправили ваш заказ [Заказ.Дата отправки]. На следующий заказ у Вас будет скидка [Клиент.Скидка]."
        }
      ]
    }
  ]
}