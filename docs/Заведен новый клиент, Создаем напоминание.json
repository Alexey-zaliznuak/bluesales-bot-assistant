// Это пример файла с настройками правил автоматизации,
// который автоматически создает напоминание при создании нового клиента.

{
  "automationRules": [
    {
      "name": "Сохранен новый клиент => Устанавливаем напоминание",
      // Раздел, в котором задаются условия.
      "conditions": [
        {
          // Тип условия.
          // "customerAdded" означает сохранение нового клиента (любым способом: это может быть
          // через плагин, админку BlueSales или через механизм автоматического сохранения).
          "type": "customerAdded"
        }
      ],
      // Действия, которые необходимо выполнить при сохранении нового клиента
      // (в данном примере мы только устанавливаем напоминание, но можно добавить
      // и другие дополнительные действия, например, установку определенного тэга).
      "actions": [
        // Установить дату следующего контакта (напоминания).
        {
          "type": "setNextContactDate",
          // Через сколько дней напоминание установить.
          "daysFromToday": 3,
          // Если true, обнулит дату следующего контакта.
          "setNextContactDateToNull": false
        }
      ]
    }
  ]
}
