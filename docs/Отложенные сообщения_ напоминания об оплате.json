// Бот, отправляющий отложенные будущие сообщения.
// Логика работы бота:
// 1) Если менеджер отправляет клиенту сообщение, содержащее текст "ждем оплату",
// бот отправит через 10 и 20 секунд напоминание об оплате.
// 2) Если клиент напишет любое сообщение,
// запланированные сообщения будут отменены (например, если клиент напишет "Оплатил",
// нет смысла ему продолжать напоминать об оплате).

// Важно: у 1 клиента может быть максимум 30 активных отложенных действий.
// В случае превышения лимита новые отложенные действия добавляться не будут.
// Речь идет именно об активных отложенных действиях (ожидающих выполнения).
// Чтобы не превышать лимита, лишние отложенные действия можно отменять.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // true означает исходящее сообщение от менеджера клиенту.
          "isOut": true,
          "anyWordsInMessage": [
            "ждем оплату"
          ]
        }
      ],
      "actions": [
        // Ставим клиенту статус "Ожидаем оплату".
        {
          "type": "setCrmStatus",
          "name": "Ожидаем оплату"
        },
        {
          // Добавление будущего события.
          "type": "addFutureAction",
          // Произвольный код, который будет сохранен у данного будущего действия.
          // Таким образом можно объединять ряд будущих действий в 1 "цепочку" сообщений.
          // Код указывать НЕ обязательно, но нам он нужен, чтобы можно было
          // отменить все будущие события с данным кодом.
          "code": "Напоминание об оплате",
          // Задержка в выполнении действия.
          // Важно: когда мы добавляем несколько будущих действий подряд,
          // задержка считается от момента добавления.
          // Иными словами, для 3 последовательных действий с интервалом в 1 час
          // нужно указать delay 1, 2 и 3 часа, соответственно.
          "delay": {
            // Можно указать дни, часы, минуты и секунды.
            // Ненужные компоненты можно не указывать.
            "days": 0,
            "hours": 0,
            "minutes": 0,
            // Задержка 10 секунд.
            "seconds": 10,
            // Корректировка времени выполнения действия случайным образом.
            // В данном примере случайная вариация составляет 2 секунды: это означает,
            // что время выполнения действия будет скорректировано на плюс / минус 2 секунды.
            // Например, если действие запланировано на 20:00, оно будет выполнено в интервале
            // от 19:59:58 до 20:00:02.
            // Формат: "00:01" = 1 минута, "00:00:03" = 3 секунды.
            "randomVariation": "00:00:02"
          },
          // Набор условий, которые будут проверены в будущий момент времени, перед выполнением действий.
          // Данный раздел указывать не обязательно.
          "conditions": [
            {
              "type": "crmStatusEquals",
              "name": "Ожидаем оплату"
            }
          ],
          "actions": [
            {
              "type": "addTag",
              "name": "Напоминание 1"
            }
          ],
          // Сообщение, которое отправляем.
          // Его может не быть.
          // Важно: сначала выполняется набор действий в разделе "actions", и только после
          // этого отправляется сообщение. Это сделано по той причине, что сообщение отправляется
          // с небольшой задержкой (это может быть 1-5 секунд). Поэтому, чтобы избежать ненужных задержек
          // в выполнении actions, они выполняются до отправки сообщения.
          "message": "[Имя], подскажите, произвели ли Вы оплату?"
        },
        {
          "type": "addFutureAction",
          "code": "Напоминание об оплате",
          // Задержка в 20 секунд.
          // Важно: это задержка с момента, когда менеджер написал "ждем оплату", а НЕ
          // задержка с предыдущего действия.
          "delay": {
            "seconds": 20
          },
          // Набор условий, которые будут проверены в будущий момент времени, перед выполнением действий.
          // Данный раздел указывать не обязательно.
          "conditions": [
            {
              //
              "type": "crmStatusEquals",
              "name": "Ожидаем оплату"
            }
          ],
          "actions": [
            {
              "type": "addTag",
              "name": "Напоминание 2"
            }
          ],
          // Сообщение, которое отправляем.
          "message": "[Имя], подскажите, когда Вы сможете оплатить заказ?"
        }
      ]
    },
    // Если клиент пишет любое сообщение, с любым текстом,
    // отменяем запланированные будущие действия.
    {
      "conditions": [
        // Реагируем на любое входящее сообщение от клиента,
        // вне зависимости от текста сообщения.
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false
        }
      ],
      "actions": [
        {
          // Отмена будущих действий с кодом "Напоминание об оплате".
          "type": "cancelFutureActions",
          "code": "Напоминание об оплате"
        }
      ]
    }
  ]
}
