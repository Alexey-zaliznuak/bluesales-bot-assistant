// Это пример файла с настройками правил автоматизации,
// который устанавливает клиенту определенный тэг в зависимости от того,
// какой менеджер ВК завел клиента через плагин.

{
  "automationRules": [
    // Правило 1: Менеджер ВК "1234567" => ставим тэг "Иван Иванов".
    {
      // Раздел, в котором задаются условия.
      "conditions": [
        {
          // Тип условия.
          // "customerAdded" означает сохранение нового клиента.
          "type": "customerAdded"
        },
        // Условие для проверки значения поля клиента.
        // В данном случае мы проверяем, что у сохраняемого клиента
        // определенный менеджер ВК.
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер ВК",
          // VK id менеджера ВК.
          "valueAsText": "1234567"
        }
      ],
      // Действия, которые необходимо выполнить, если сохранен клиент
      // с указанным выше менеджером ВК.
      "actions": [
        // Установить тэг.
        {
          "type": "addTag",
          "name": "Иван Иванов"
        }
      ]
    },

    // Правило 2: менеджер ВК "7654321" => Менеджер ВК "Алексей Петров".
    // Для дополнительных менеджеров ВК нужно в аналогичном формате добавить
    // такие же разделы.
    {
      "conditions": [
        {
          "type": "customerAdded"
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Менеджер ВК",
          "valueAsText": "7654321"
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "Алексей Петров"
        }
      ]
    }
  ]
}
