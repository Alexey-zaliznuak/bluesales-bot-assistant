// Демонстрация проверки значений полей клиентов.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          // Входящее сообщение от клиента.
          "isOut": false
        },
        {
          "type": "crmStatusEquals",
          "name": "Ожидаем оплату"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "У вас статус «Ожидаем оплату» :)"
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          // Проверяем значение поля "Город" у клиента.
          // Если в поле содержится значение "Казань", правило срабатывает.
          // Таким образом можно проверять значения как стандартных (системных) полей,
          // так и дополнительных полей клиентов (создаваемых в разделе Настройки / Поля / Клиенты).
          "type": "customerFieldEquals",
          "fieldName": "Город",
          "valueAsText": "Казань"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Вы из Казани :)"
        }
      ]
    },
    {
      "conditions": [
        // Реагируем на любое сообщение: как входящее, так и исходящее.
        {
          "type": "newMessage",
          "isOut": false
        },
        {
          "type": "customerFieldEquals",
          "fieldName": "Дата следующего контакта",
          // Поле "Дата следующего контакта" является датой.
          // Для полей-дат можно проверять количество дней от сегодняшней даты
          // до даты, указанной в поле.
          "daysFromToday": {
            // "Дата следующего контакта" минус "Сегодня" = 1 (т. е. это "Завтра").
            "equals": 1

            // Ниже приведены другие варианты условий.
            // Эти условия можно совмещать для достижения логики вида:
            // "Дата следующего контакта" находится в интервале от +2 до +5 дней от текущей даты.

            // "Дата следующего контакта" минус "Сегодня" > 2
            // (т. е. "Дата следующего контакта" содержит более позднее значение,
            // чем "послезавтра").
            // "greaterThan": 2

            // "Дата следующего контакта" минус "Сегодня" < -2
            // (т. е. "Дата следующего контакта" содержит более раннее значение,
            // чем "позавчера").
            // "lessThan": -2

            // "Дата следующего контакта" минус "Сегодня" >= 2
            // "greaterThanOrEqualTo": 2

            // "Дата следующего контакта" минус "Сегодня" <= -2
            // "lessThanOrEqualTo": -2
          }
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Планируем связаться с вами завтра."
        }
      ]
    }
  ]
}
