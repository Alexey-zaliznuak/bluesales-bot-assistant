{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "setCrmStatus",
          "name": "Ожидаем оплату",
          // Изменяем статус CRM только "наверх".
          // Иными словами, если у клиента уже установлен статус, который находится
          // выше по воронке продаж, статус меняться не будет.
          // Например, если у клиента установлен статус "Оплачен", то
          // статус "Ожидаем оплату" установлен не будет.
          "upOnly": true
        }
      ]
    }
  ]
}
