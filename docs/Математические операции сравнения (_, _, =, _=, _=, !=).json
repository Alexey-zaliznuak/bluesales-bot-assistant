// В данном боте демонстрируются математические операции сравнения.
// Для работы бота требуется создать числовое поле с названием "Число" в разделе
// Настройки / Поля / Клиенты.
// Бот работает следующим образом:
// 1) Клиент отправляет боту сообщение с текстом "+".
// 2) Бот прибавляет 1 к значению поля "Число", если значение в этом поле меньше 5.
// 3) Если же значение в поле больше или равно 5, бот изменяет значение в поле на 1.
// 4) После изменения значения поля бот отправляет клиенту сообщение с новым значением поля.
// Таким образом, если клиент последовательно отправляет сообщение "+", значение в поле меняется
// следующим образом: 1, 2, 3, 4, 5, 1, 2, 3 и т. д.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "+"
          ]
        },
        {
          // Проверяем, что поле либо не заполнено, либо его значение меньше 5: если это так,
          // увеличиваем значение поля на 1.
          // В данном случае мы проверяем значения поля клиента ("customerFieldEquals").
          // Если нужно проверить значение поля заказа, нужно указать "orderFieldEquals".
          "or": [
            {
              "type": "customerFieldEquals",
              "fieldName": "Число",
              "valueAsText": null
            },
            {
              "type": "customerFieldEquals",
              // Проверяем значение в поле клиента, которое называется "Число".
              "fieldName": "Число",
              "math": {
                // Проверяем, что число меньше 5.
                // Поддерживаются следующие операторы сравнения:
                // 1) "=" (равно)
                // 2) "<" (меньше)
                // 3) ">" (больше)
                // 4) "<=" (меньше или равно)
                // 5) ">=" (больше или равно)
                // 6) "!=" (не равно)
                "operator": "<",
                "value": 5
              }
            }
          ]
        }
      ],
      "actions": [
        {
          // Увеличиваем значение в поле "Число" на 1.
          "type": "setCustomerField",
          "fieldName": "Число",
          "math": {
            "operator": "+",
            "value": 1
          }
        },
        {
          "type": "sendMessage",
          "message": "Число увеличено на 1 и равно [Клиент.Число]."
        }
      ]
    },
    {
      "conditions": [
        {
          "type": "newMessage",
          "isOut": false,
          "anyWordsInMessage": [
            "+"
          ]
        },
        {
          // Проверяем, что значение в поле "Число" больше или равно 5.
          "type": "customerFieldEquals",
          "fieldName": "Число",
          "math": {
            "operator": ">=",
            "value": 5
          }
        }
      ],
      "actions": [
        // Устанавливаем в поле "Число" значение 1.
        {
          "type": "setCustomerField",
          "fieldName": "Число",
          "valueAsText": "1"
        },
        {
          "type": "sendMessage",
          "message": "Число больше или равно 5, поэтому будет установлено значение 1."
        }
      ]
    }
  ]
}
