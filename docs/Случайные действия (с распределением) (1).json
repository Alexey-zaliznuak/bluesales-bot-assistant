// Данное правило автоматизации работает следующим образом:
// 1) Клиент пишет любое сообщение.
// 2) Бот отправляет клиенту в ответ "Дождь" с вероятностью 50%,
// "Снег" с вероятностью 30% и "Град" с вероятностью 20%.

{
  "automationRules": [
    {
      "conditions": [
        {
          // Реагируем на любое сообщение от клиента в группе ВК,
          // на текст не обращаем внимания.
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false
        }
      ],
      "actions": [
        {
          "type": "random",
          // Задаем распределение случайных действий.
          // Распределение может включать в себя любое количество действий,
          // с различными вероятностями.
          // Сумма вероятностей должна быть равна 1; если это не так, бот
          // автоматически скорректирует значения вероятностей таким образом,
          // чтобы в сумме они были равны 1.
          // Например, если указать в качестве вероятностей значения 20 и 30,
          // бот превратит их в 0.4 и 0.6.
          "distribution": [
            {
              "probability": 0.5,
              "actions": [
                {
                  "type": "sendMessage",
                  "message": "Дождь :)"
                }
              ]
            },
            {
              "probability": 0.3,
              "actions": [
                {
                  "type": "sendMessage",
                  "message": "Снег :)"
                }
              ]
            },
            {
              "probability": 0.2,
              "actions": [
                {
                  "type": "sendMessage",
                  "message": "Град :)"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
