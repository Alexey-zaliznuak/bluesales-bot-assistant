// В некоторых случаях после выполнения определенных условий
// имеет смысл остановить работу бота и выйти из него.
// За это отвечает действие "stopProcessing".

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "да"
          ]
        },
        {
          "type": "hasTag",
          "name": "VIP"
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "VIP 2"
        },
        // Останавливаем процесс выполнения любых действий и выходим из бота.
        {
          "type": "stopProcessing",

          // Возможные значения:
          // 1) "currentOnly": выйти только из текущего файла бота,
          // но продолжить выполнение остальных файлов ботов.
          // 2) "all": выйти из текущего файла бота, а также
          // прекратить обработку события всеми остальными файлами ботов.
          // Если не указывать значение настройки "exitBots", по умолчанию
          // будет использоваться значение "all".
          "exitBots": "currentOnly"
        },
        // Данное действие уже не будет выполнено, т. к. выше стоит действие "stopProcessing".
        {
          "type": "addTag",
          "name": "VIP 3"
        }
      ]
    },
    // Этот блок не будет выполнен, т. к. выше стоит действие "stopProcessing".
    {
      "conditions": [
        {
          "type": "newMessage",
          "anyWordsInMessage": [
            "да"
          ]
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "VIP 4"
        }
      ]
    }
  ]
}
