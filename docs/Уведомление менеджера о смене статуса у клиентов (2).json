// Данный бот отправляет уведомление менеджеру / администратору,
// как только у любого клиента изменяется статус (бот реагирует только
// на ручную смену статуса).
// В уведомлении содержится ФИО и ссылка на клиента, а также название статуса CRM.

{
  "automationRules": [
    {
      "conditions": [
        {
          "type": "crmStatusChanged"
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "У клиента [Клиент.ФИО] (https://bluesales.ru/app/Customers/CustomerView.aspx?id=[Клиент.Id]) статус изменился на «[Клиент.CRM-статус]»",

          "to": {
            // Канал, от имени которого будет отправлено сообщение менеджеру / администратору.
            // Канал должен быть подключен к BlueSales.
            "channel": {
              // Тип канала: "vkGroup", "okGroup", "instagram", "whatsApp",
              // "telegram" (бот Telegram), "telegramPersonal" (номер Telegram).
              "type": "vkGroup",
              // Для групп ВК и ОК нужно указать числовой id группы.
              // Для Instagram нужно указать числовой id страницы Instagram.
              // Для номеров WhatsApp и Telegram нужно указать номер в формате "79161234567".
              // Для ботов Telegram нужно указать числовой id бота.
              // Для получения числового id можете написать в сообщения группы BlueSales.
              "id": "114745703"
            },
            // Числовой id или телефон (в случае номеров WhatsApp или Telegram) менеджера / администратора.
            // Чтобы отправить сообщение в чат группы ВК, нужно указать ее id в формате "2000000001", "2000000002" и т. д.
            // (последняя цифра является номером группового чата).
            "id": "289832607"
          }
        }
      ]
    }
  ]
}
