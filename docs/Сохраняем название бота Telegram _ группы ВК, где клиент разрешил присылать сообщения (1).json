// Пример бота, который устанавливает в поле "Разрешил сообщения"
// название бота, в котором клиент разрешил присылать ему сообщения.
// Бот особенно полезен для фильтрации клиентов при создании рассылки,
// чтобы не отправлять сообщение клиентам, кто запретил присылать сообщения.

// Бот работает следующим образом:

// 1) Если клиент разрешает присылать ему сообщения (данное событие есть только
// в группах ВК и в ботах Telegram), либо происходит успешная отправка или
// получение сообщения от клиента (что автоматически говорит о том, что
// отправка сообщений разрешена), в поле-мультисписок "Разрешил сообщения"
// добавляется название бота Telegram.

// 2) Если клиент блокирует возможность отправки ему сообщений (в группе ВК или
// боте Telegram), из поля "Разрешил сообщения" удаляется название бота.

// Цель заключается в том, чтобы в любой момент времени в поле "Разрешил сообщения"
// содержались названия ботов Telegram, в которых клиенту можно отправлять сообщения.

// При создании рассылки можно производить фильтрацию по полю "Разрешил сообщения",
// чтобы отправлять рассылку только тем клиентам, у кого сообщения "открыты".

// Чтобы данный бот работал, следует создать поле-мультисписок с названием "Разрешил сообщения"
// и указать названия ботов, с которыми происходит работа.
// Создание поля происходит в разделе:
// Настройки / Поля / Клиенты

// Для первоначального быстрого заполнения поля лучше всего запустить массовую рассылку
// по всей аудитории бота Telegram: в этом случае всем клиентам, кому сообщение рассылки
// будет успешно отправлено, бот заполнит поле "Разрешил сообщения".
// После этого можно будет делать рассылку сообщений, производя фильтрацию по этому полю,
// и рассылка будет отправляться только тем клиентам, у кого сообщения "открыты".

// Для каждого используемого бота Telegram или группы ВК следует создать отдельного бота,
// взяв за основу данный файл и изменив название бота Telegram в коде.

{
  "automationRules": [
    {
      "conditions": [
        {
          // Если клиент разрешил получение сообщений,
          // либо если отправлено / получено сообщение,
          // добавляем название бота (или группы ВК)
          // в поле "Разрешил сообщения".
          "or": [
            {
              "type": "messageAllow",
              "channel": {
                // Для группы ВК тут следует указать "vkGroup".
                "type": "telegram",
                // Для группы ВК тут следует указать числовое id
                // группы, например: "114745703".
                "id": "TestJune2021Bot"
              }
            },
            {
              "type": "newMessage",
              "channel": {
                // Для группы ВК следует указать "vkGroup" и
                // числовой id группы в формате "114745703".
                "type": "telegram",
                "id": "TestJune2021Bot"
              }
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          // Название поля-мультисписка, созданного в разделе:
          // Настройки / Поля / Клиенты
          "fieldName": "Разрешил сообщения",
          // Название бота Telegram или группы ВК.
          // Можно использовать любое удобное название.
          // Важно: названия ботов и групп ВК следует заранее настроить
          // в качестве возможных значений поля-мультисписка.
          "addValueAsText": "TestJune2021Bot"
        }
      ]
    },
    // Если клиент заблокировал получение сообщений, удаляем название бота
    // из поля "Разрешил сообщения".
    {
      "conditions": [
        {
          "type": "messageDeny",
          "channel": {
            "type": "telegram",
            "id": "TestJune2021Bot"
          }
        }
      ],
      "actions": [
        {
          "type": "setCustomerField",
          "fieldName": "Разрешил сообщения",
          "removeValueAsText": "TestJune2021Bot"
        }
      ]
    }
  ]
}
