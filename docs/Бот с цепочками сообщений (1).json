// Пример достаточно сложного бота, который отправляет клиент цепочки отложенных
// сообщений с определенным интервалом, "уговаривая" его приобрести тренинг и внести оплату.

{
  "automationRules": [
    // =====================
    // ===== Цепочка 1 =====
    // =====================
    {
      "conditions": [
        {
          // Включаем цепочку 1 при выполнении одного из 2 условий.
          // Тут используется условие "или" ("or").
          "or": [
            // 1) Клиент написал "да" и у него статус "Поинтересовался".
            // Оба эти условия объединены ключевым словом "and".
            {
              "and": [
                {
                  "type": "newMessage",
                  // false означает входящее сообщение от клиента.
                  "isOut": false,
                  "anyWordsInMessageWholeMatch": [
                    "да"
                  ]
                },
                // Проверяем, что CRM-статус имеет определенное значение.
                // Таким образом можно проверять значение любого стандартного
                // и дополнительного поля.
                // Для полей-дат значение нужно указывать в формате "31.12.2018".
                {
                  "type": "crmStatusEquals",
                  "name": "Поинтересовался"
                }
              ]
            },
            // 2) У клиента был установлен тэг Ц1.
            // Важно: правила автоматизации реагируют только на ручное изменение тэгов.
            // Если тэг был изменен другим правилом автоматизации, событие изменения тэга
            // не генерируется.
            // Также сейчас не срабатывает событие, если тэг был установлен массово (так как
            // могут быть проблемы с производительностью, если, например, включить сразу 500 цепочек).
            {
              "type": "tagsChanged",
              "addedTags": [
                {
                  "name": "Ц1"
                }
              ]
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "addTag",
          "name": "Ц1"
        },
        {
          // Добавление будущего события.
          "type": "addFutureAction",
          // Произвольный код, который будет сохранен у данного будущего действия.
          // Таким образом можно объединять ряд будущих действий в 1 "цепочку".
          // Код указывать НЕ обязательно.
          "code": "Ц1",
          // Задержка.
          // Важно: когда мы добавляем несколько будущих действий подряд,
          // задержка считается от момента добавления.
          // Иными словами, для 3 последовательных действий с интервалом в 1 час
          // нужно указать delay 1, 2 и 3 часа, соответственно.
          "delay": {
            // Можно указать дни, часы, минуты и секунды.
            // Ненужные компоненты можно не указывать.
            "days": 0,
            "hours": 0,
            "minutes": 0,
            "seconds": 3
          },
          "conditions": [
            // Лучше в каждом futureAction цепочки проверять, что тэг цепочки еще стоит.
            // Для чего это может пригодиться: если удалить тэг цепочки массово, то сейчас
            // НЕ сработает событие снятия тэга у клиента, и цепочка не будет отключена.
            // Но если проверять в каждом futureAction наличие тэга перед отправкой сообщения,
            // сообщение не будет отправлено, если тэга нет.
            {
              "type": "hasTag",
              "name": "Ц1"
            }
          ],
          "actions": [
            {
              "type": "setCrmStatus",
              "name": "Будете участвовать?"
            },
            {
              "type": "setCustomerField",
              "fieldName": "Отправленные сообщения",
              // Фиксируем код отправленного сообщения, для статистики.
              // Это поле типа "Мультисписок".
              "addValueAsText": "Ц1-С1"
            }
          ],
          // Сообщение, которое отправляем.
          // Его может не быть.
          // Важно: сначала выполняется набор действий в разделе "actions", и только после
          // этого отправляется сообщение. Это сделано по той причине, что сообщение отправляется
          // с небольшой задержкой (это может быть 1-5 секунд). Поэтому, чтобы избежать ненужных задержек
          // в выполнении actions, они выполняются до отправки сообщения.
          "message": "[Имя], у нас лучший тренинг по созданию сайтов.\n\nЗа 2 недели вы научитесь самостоятельно создавать сайты.\n\nБудете участвовать? :)"
        },
        {
          "type": "addFutureAction",
          "code": "Ц1",
          // Задержка.
          "delay": {
            "seconds": 15
          },
          // Условия, которые будут проверяться перед выполнением действий и отправкой сообщения.
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц1"
            }
          ],
          "message": "[Имя], ну так что, примете участие в тренинге? :)",
          "actions": [
            {
              "type": "setCustomerField",
              "fieldName": "Отправленные сообщения",
              "addValueAsText": "Ц1-С2"
            }
          ]
        },
        {
          "type": "addFutureAction",
          "code": "Ц1",
          // Задержка.
          "delay": {
            "seconds": 25
          },
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц1"
            }
          ],
          "actions": [
            {
              "type": "setCustomerField",
              "fieldName": "Отправленные сообщения",
              "addValueAsText": "Ц1-С3"
            }
          ],
          "message": "[Имя], мы научим вас создавать сайты! Вы примете участие в нашем тренинге? :)"
        },
        // Если клиент так и не отвечает, переводим клиента в статус "Ручная обработка".
        {
          "type": "addFutureAction",
          "code": "Ц1",
          // Задержка.
          "delay": {
            "seconds": 35
          },
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц1"
            }
          ],
          // Удаляем тэг цепочки, ставим статус "Ручная обработка".
          "actions": [
            {
              "type": "removeTag",
              "name": "Ц1"
            },
            {
              "type": "setCrmStatus",
              "name": "Ручная обработка"
            }
          ]
        }
      ]
    },
    // Снимаем тэг Ц1 => Отписываемся от цепочки Ц1.
    {
      "conditions": [
        {
          "type": "tagsChanged",
          "removedTags": [
            {
              "name": "Ц1"
            }
          ]
        }
      ],
      "actions": [
        // Отменяем все будущие действия с кодом "Ц1".
        {
          "type": "cancelFutureActions",
          "code": "Ц1"
        },
        {
          // Чисто информационное сообщение, для наглядности.
          "type": "sendMessage",
          "message": "Отписались от цепочки Ц1."
        }
      ]
    },

    // =====================
    // ===== Цепочка 2 =====
    // =====================
    {
      "conditions": [
        {
          // Включаем цепочку 2 при выполнении одного из 2 набора условий:
          // 1) Клиент написал "да" и у него стоит тэг "Ц1".
          // 2) Вручную был установлен тэг "Ц2".
          "or": [
            {
              "and": [
                {
                  "type": "newMessage",
                  // false означает входящее сообщение от клиента.
                  "isOut": false,
                  "anyWordsInMessageWholeMatch": [
                    "да"
                  ]
                },
                {
                  "type": "hasTag",
                  "name": "Ц1"
                }
              ]
            },
            {
              "type": "tagsChanged",
              "addedTags": [
                {
                  "name": "Ц2"
                }
              ]
            }
          ]
        }
      ],
      "actions": [
        // Удаляем все запланированные будущие действия для данного клиента,
        // имеющие код Ц1, то есть удаляем цепочку 1.
        // И включаем цепочку 2.
        {
          "type": "cancelFutureActions",
          "code": "Ц1"
        },
        {
          "type": "removeTag",
          "name": "Ц1"
        },
        {
          "type": "addTag",
          "name": "Ц2"
        },
        {
          // Добавление будущего события.
          "type": "addFutureAction",
          "code": "Ц2",
          // Задержка.
          // Важно: когда мы добавляем несколько будущих действий подряд,
          // задержка считается от момента добавления.
          // Иными словами, для 3 последовательных действий с интервалом в 1 час
          // нужно указать delay 1, 2 и 3 часа, соответственно.
          "delay": {
            // Можно указать дни, часы, минуты и секунды.
            // Ненужные компоненты можно не указывать.
            "days": 0,
            "hours": 0,
            "minutes": 0,
            "seconds": 3
          },
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц2"
            }
          ],
          "actions": [
            {
              "type": "setCrmStatus",
              "name": "Сможете оплатить?"
            },
            {
              "type": "setCustomerField",
              "fieldName": "Сумма",
              "valueAsText": "3000"
            },
            {
              "type": "setCustomerField",
              "fieldName": "Отправленные сообщения",
              "addValueAsText": "Ц2-С1"
            }
          ],
          "message": "Рады, что вы будете участвовать!\n\n[Имя], Вы сможете оплатить 3000 рублей? :)"
        },
        {
          "type": "addFutureAction",
          "code": "Ц2",
          // Задержка.
          "delay": {
            "seconds": 15
          },
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц2"
            }
          ],
          "actions": [
            {
              "type": "setCustomerField",
              "fieldName": "Сумма",
              "valueAsText": "2000"
            },
            {
              "type": "setCustomerField",
              "fieldName": "Отправленные сообщения",
              "addValueAsText": "Ц2-С2"
            }
          ],
          "message": "[Имя], можем сделать вам скидку: тренинг будет стоить всего 2000 руб. вместо 3000 руб. :) Оплатите?"
        },
        {
          "type": "addFutureAction",
          "code": "Ц2",
          // Задержка.
          "delay": {
            "seconds": 25
          },
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц2"
            }
          ],
          "actions": [
            {
              "type": "setCustomerField",
              "fieldName": "Сумма",
              "valueAsText": "500"
            },
            {
              "type": "setCustomerField",
              "fieldName": "Отправленные сообщения",
              "addValueAsText": "Ц2-С3"
            }
          ],
          "message": "[Имя], у вас совсем денег нет? :( Хотя бы 500 руб. можете оплатить?"
        },
        {
          "type": "addFutureAction",
          "code": "Ц2",
          // Задержка.
          "delay": {
            "seconds": 35
          },
          "conditions": [
            {
              "type": "hasTag",
              "name": "Ц2"
            }
          ],
          "actions": [
            {
              "type": "removeTag",
              "name": "Ц2"
            },
            {
              "type": "setCrmStatus",
              "name": "Ручная обработка"
            }
          ]
        }
      ]
    },
    // Снимаем тэг Ц2 => Отписываемся от цепочки Ц2.
    {
      "conditions": [
        {
          "type": "tagsChanged",
          "removedTags": [
            {
              "name": "Ц2"
            }
          ]
        }
      ],
      "actions": [
        // Отменяем все будущие действия с кодом "Ц1".
        {
          "type": "cancelFutureActions",
          "code": "Ц1"
        },
        {
          // Чисто информационное сообщение, для наглядности.
          "type": "sendMessage",
          "message": "Отписались от цепочки Ц2."
        }
      ]
    },

    // ===============================
    // ===== Согласился оплатить =====
    // ===============================
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            "да",
            "хорошо",
            // Кириллицей.
            "ок",
            // Латиницей.
            "ok",
            "ладно"
          ]
        },
        {
          "type": "hasTag",
          "name": "Ц2"
        }
      ],
      "actions": [
        {
          "type": "cancelFutureActions",
          "code": "Ц2"
        },
        {
          "type": "removeTag",
          "name": "Ц2"
        },
        {
          "type": "setCrmStatus",
          "name": "Ожидаем оплату"
        },
        // Сообщение отправляем самым последним действием, уже после удаления будущих событий
        // данной цепочки. Если это делать НЕ в самом конце, есть риск того,
        // что пока мы будем отправлять сообщение (это может занять 1-3 секунды)
        // уже сработает отправка следующего сообщения предыдущей цепочки.
        {
          "type": "sendMessage",
          "message": "Отлично, [Имя]! :)\n\nЖдем оплату на карту Сбербанка 1111 2222 3333 4444 :)"
        }
      ]
    },

    // ========================================================
    // ===== Цепочка Ц3: включение / отключение через тэг =====
    // ========================================================

    // Отдельная цепочка, которая включается только через тэг.
    {
      "conditions": [
        {
          "type": "tagsChanged",
          "addedTags": [
            {
              "name": "Ц3"
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": "Подписываемся на цепочку Ц3."
        },
        {
          "type": "addFutureAction",
          "code": "Ц3",
          // Задержка.
          "delay": {
            "seconds": 10
          },
          "message": "Первое сообщение цепочки Ц3, через 10 секунд."
        },
        {
          "type": "addFutureAction",
          "code": "Ц3",
          // Задержка.
          "delay": {
            "seconds": 20
          },
          "message": "Второе сообщение цепочки Ц3, еще через 10 секунд."
        },
        {
          "type": "addFutureAction",
          "code": "Ц3",
          // Задержка.
          "delay": {
            "seconds": 30
          },
          "message": "Третье сообщение цепочки Ц3, еще через 10 секунд.\n\nЦепочка завершена.",
          "actions": [
            {
              "type": "removeTag",
              "name": "Ц3"
            }
          ]
        }
      ]
    },
    // Отключаем цепочку Ц3, если тэг Ц3 снят.
    {
      "conditions": [
        {
          "type": "tagsChanged",
          "removedTags": [
            {
              "name": "Ц3"
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "cancelFutureActions",
          "code": "Ц3"
        },
        {
          "type": "sendMessage",
          "message": "Отписались от цепочки Ц3."
        }
      ]
    },

    // ==================================
    // ===== Реакция на оскорбление =====
    // ==================================
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            "к черту",
            "куда подальше",
            "надоели"
          ]
        }
      ],
      "actions": [
        {
          // Отписываемся от всех будущих событий, с любыми кодами.
          "type": "cancelFutureActions"
        },
        // Удаляем тэги всех цепочек.
        {
          "type": "setTags",
          "removeTags": [
            {
              "name": "Ц1"
            },
            {
              "name": "Ц2"
            },
            {
              "name": "Ц3"
            }
          ]
        },
        {
          "type": "addTag",
          "name": "Негатив"
        },
        {
          "type": "sendMessage",
          "message": "Понял, не буду вас больше беспокоить.\n\nВсего вам наилучшего!"
        }
      ]
    },

    // ===============================
    // ===== Реакция на смайлики =====
    // ===============================
    {
      "conditions": [
        {
          "type": "newMessage",
          // false означает входящее сообщение от клиента.
          "isOut": false,
          "anyWordsInMessage": [
            ":)",
            "=)"
          ]
        }
      ],
      "actions": [
        {
          "type": "sendMessage",
          "message": ":)"
        }
      ]
    },

    // ======================================================
    // ===== Восстановление исходного состояния клиента =====
    // ======================================================

    // Сделано для удобства тестирования: при установке статуса "Поинтересовался"
    // или при отправке слова "заново" восстанавливаем исходное состояние клиента.
    {
      "conditions": [
        {
          "or": [
            {
              "type": "crmStatusChanged",
              "newStatus": {
                "name": "Поинтересовался"
              }
            },
            {
              "type": "newMessage",
              "anyWordsInMessageWholeMatch": [
                "заново"
              ]
            }
          ]
        }
      ],
      "actions": [
        {
          // Отписываемся от всех будущих событий, с любыми кодами.
          "type": "cancelFutureActions"
        },
        {
          "type": "setCrmStatus",
          "name": "Поинтересовался"
        },
        // Удаляем тэги всех цепочек.
        {
          "type": "setTags",
          "removeTags": [
            {
              "name": "Ц1"
            },
            {
              "name": "Ц2"
            },
            {
              "name": "Ц3"
            },
            {
              "name": "Негатив"
            }
          ]
        },
        {
          "type": "setCustomerField",
          "fieldName": "Отправленные сообщения",
          // Очищаем все значения в поле.
          "valueAsText": null
        },
        {
          "type": "setCustomerField",
          "fieldName": "Сумма",
          "valueAsText": null
        }
      ]
    }
  ]
}
