# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env
# docker compose подключает .env через env_file во все сервисы.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=bluesales
POSTGRES_PASSWORD=bluesales_change_me
POSTGRES_DB=bluesales
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Порт, на котором Postgres будет доступен с хоста
POSTGRES_EXPOSED_PORT=5433
# Строка подключения для бэкенда (хост = имя сервиса в compose)
DATABASE_URL=postgres://bluesales:bluesales_change_me@db:5432/bluesales?sslmode=disable

# --- API -------------------------------------------------------------------
APP_ENV=development
API_PORT=8080
# Порт API на хосте (8080 на Windows часто занят Docker Desktop)
API_EXPOSED_PORT=8088
# Разрешённые Origin через запятую (dev-сервер Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=bsa_session
SESSION_TTL_HOURS=720
# true только при работе по HTTPS
SESSION_COOKIE_SECURE=false

# --- Сид-пользователь (создаётся сервисом seed) -----------------------------
SEED_USER_LOGIN=admin
SEED_USER_PASSWORD=admin_change_me

# --- OpenRouter ------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-luna
# none | low | medium | high | xhigh | max
OPENROUTER_REASONING_EFFORT=max
# HTTP/HTTPS/SOCKS5 прокси. Оставьте пустым для прямого подключения.
OPENROUTER_PROXY_URL=
OPENROUTER_TIMEOUT_SECONDS=300
# Заголовки для рейтингов OpenRouter (необязательные)
OPENROUTER_APP_TITLE=BlueSales Bot Assistant
OPENROUTER_HTTP_REFERER=http://localhost:5173

# --- Вложения в чате -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
MAX_UPLOAD_FILES=10
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.csv,.json,.yaml,.yml,.log,.xml,.sql,.ini,.conf

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
# Порт Vite dev-сервера на хосте
FRONTEND_EXPOSED_PORT=5173
# Куда Vite проксирует /api внутри docker-сети
VITE_API_PROXY_TARGET=http://api:8080
